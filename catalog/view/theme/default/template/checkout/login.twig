<div class="row">
  <div class="col-sm-6" style="text-align: left;">
    <h2 style="margin-top: 0; text-align: left;">{{ text_new_customer }}</h2>
    <p style="margin-top: -5px; text-align: left;">{{ text_checkout }}</p>
    <div class="radio" style="text-align: left;">
      <label> {% if account == 'register' %}
        <input type="radio" name="account" value="register" checked="checked" />
        {% else %}
        <input type="radio" name="account" value="register" />
        {% endif %}
        {{ text_register }}</label>
    </div>
    {% if checkout_guest %}
    <div class="radio" style="text-align: left;">
      <label> {% if account == 'guest' %}
        <input type="radio" name="account" value="guest" checked="checked" />
        {% else %}
        <input type="radio" name="account" value="guest" />
        {% endif %}
        {{ text_guest }}</label>
    </div>
    {% endif %}
    <p style="text-align: left;">{{ text_register_account }}</p>
    <button type="button" id="button-account" data-loading-text="" class="btn btn-primary btn-continue-custom" style="margin-top: 20px;">{{ button_continue }}</button>
  </div>
  <div class="col-sm-6" style="text-align: left;">
    <h2 style="margin-top: 0; text-align: left;">{{ text_returning_customer }}</h2>
    <div class="login-field">
      <input type="text" name="email" value="" placeholder=" " id="input-email" class="login-field__input" autocomplete="email" />
      <label class="login-field__label" for="input-email">{{ entry_email }}</label>
    </div>
    <div class="login-field">
      <input type="password" name="password" value="" placeholder=" " id="input-password" class="login-field__input" autocomplete="current-password" />
      <label class="login-field__label" for="input-password">{{ entry_password }}</label>
    </div>
    <div class="login-page__forgot" style="margin-top: -4px; margin-bottom: 20px; text-align: left;">
      <a href="{{ forgotten }}" class="login-page__forgot-link">Şifremi unuttum</a>
    </div>
    <input type="button" value="{{ button_login }}" id="button-login" data-loading-text="" class="btn btn-primary" style="margin-top: 10px;" />
  </div>
</div>
