{{ header }}
<div id="account-address" class="container account-page">
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}</div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-warning"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
  {% endif %}
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <h2>{{ text_address_book }}</h2>
      <style>
      /* ==========================================================================
         ADRESLERIM / MY ADDRESSES TABLE REDESIGN
         ========================================================================== */
      #account-address #content {
        max-width: 1320px !important;
        width: 100% !important;
      }

      .account-address-table-wrap {
        border: none;
        background: transparent;
        margin-bottom: 28px;
        overflow-x: visible;
        border-radius: 0;
        width: 100%;
      }

      @media (max-width: 991px) {
        .account-address-table-wrap {
          overflow-x: auto;
        }
      }

      .account-address-table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 0;
        font-family: 'DM Sans', sans-serif;
        color: #1a1a50;
        background: transparent;
        table-layout: fixed;
      }

      .account-address-table thead tr {
        background-color: #f5f2eb !important;
        border-bottom: 1px solid rgba(26, 26, 80, 0.12) !important;
      }

      .account-address-table thead th,
      .account-address-table thead td {
        padding: 14px 12px !important;
        font-family: 'DM Sans', sans-serif !important;
        font-size: 11px !important;
        font-weight: 500 !important;
        letter-spacing: 0.08em !important;
        text-transform: uppercase !important;
        color: #1a1a50 !important;
        background: transparent !important;
        border: none !important;
        border-right: 1px solid rgba(26, 26, 80, 0.08) !important;
        white-space: nowrap;
        vertical-align: middle !important;
      }

      .account-address-table thead th:last-child,
      .account-address-table thead td:last-child {
        border-right: none !important;
      }

      .account-address-table tbody tr {
        border-bottom: 1px solid rgba(26, 26, 80, 0.08) !important;
        transition: background-color 0.2s ease;
      }

      .account-address-table tbody tr:last-child {
        border-bottom: none !important;
      }

      .account-address-table tbody tr:hover {
        background-color: transparent !important;
      }

      .account-address-table tbody td {
        padding: 16px 12px !important;
        font-family: 'DM Sans', sans-serif !important;
        font-size: 13.5px !important;
        color: #1a1a50 !important;
        background: transparent !important;
        border: none !important;
        border-right: 1px solid rgba(26, 26, 80, 0.05) !important;
        vertical-align: middle !important;
        word-wrap: break-word;
      }

      .account-address-table tbody td:last-child {
        border-right: none !important;
      }

      .address-action-link {
        position: relative;
        display: inline-block;
        color: #1a1a50 !important;
        text-decoration: none !important;
        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px;
        font-weight: 500;
        letter-spacing: 0.02em;
        text-transform: capitalize;
        padding: 3px 2px;
        line-height: 1.4;
        transition: color 0.25s ease;
        margin-right: 15px;
      }

      .address-action-link:last-child {
        margin-right: 0;
      }

      .address-action-link::after {
        content: '';
        position: absolute;
        bottom: 0px;
        left: 50%;
        width: 100%;
        height: 1px;
        background-color: #1a1a50;
        transform: translateX(-50%) scaleX(0);
        transform-origin: center;
        transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      }

      .address-action-link:hover::after {
        transform: translateX(-50%) scaleX(1);
      }

      .col-address { width: auto; }
      .col-action { width: 15%; text-align: center; }
      
      .address-btn-primary {
        background-color: #1a1a50 !important;
        color: #ffffff !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 12px 25px;
        font-family: 'DM Sans', sans-serif;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: opacity 0.3s ease;
      }
      .address-btn-primary:hover {
        opacity: 0.85;
        color: #ffffff !important;
      }
      
      .address-btn-default {
        background-color: #ffffff !important;
        color: #1a1a50 !important;
        border: 1px solid #1a1a50 !important;
        box-shadow: none !important;
        border-radius: 0 !important;
        padding: 11px 25px;
        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        position: relative;
        display: inline-block;
        transition: color 0.25s ease;
      }
      .address-btn-default::after {
        content: '';
        position: absolute;
        bottom: 11px;
        left: 50%;
        width: calc(100% - 50px);
        height: 1px;
        background-color: #1a1a50;
        transform: translateX(-50%) scaleX(0);
        transform-origin: center;
        transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
      }
      .address-btn-default:hover {
        background-color: #ffffff !important;
        color: #1a1a50 !important;
      }
      .address-btn-default:hover::after {
        transform: translateX(-50%) scaleX(1);
      }
      </style>

      {% if addresses %}
      <div class="account-address-table-wrap">
        <table class="account-address-table">
          <thead>
            <tr>
              <th class="text-left col-address">ADRES BİLGİLERİ</th>
              <th class="text-center col-action"></th>
              <th class="text-center col-action"></th>
            </tr>
          </thead>
          <tbody>
          {% for result in addresses %}
          <tr>
            <td class="text-left">{{ result.address }}</td>
            <td class="text-center">
              <a href="{{ result.update }}" class="address-action-link">{{ button_edit }}</a>
            </td>
            <td class="text-center">
              <a href="{{ result.delete }}" class="address-action-link" onclick="return confirm('{{ text_confirm }}')">{{ button_delete }}</a>
            </td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% else %}
      <p>{{ text_empty }}</p>
      {% endif %}
      
      <div class="buttons clearfix">
        <div class="pull-left"><a href="{{ back }}" class="btn address-btn-default">{{ button_back }}</a></div>
        <div class="pull-right"><a href="{{ add }}" class="btn address-btn-primary">{{ button_new_address }}</a></div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
