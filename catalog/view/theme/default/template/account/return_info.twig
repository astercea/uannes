{{ header }}
<div id="account-return" class="container return-page return-page--info">
  <ul class="breadcrumb return-breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">{{ content_top }}
      <section class="return-hero return-hero--compact">
        <div class="return-hero__content">
          <span class="return-eyebrow">Uannes Care</span>
          <h1>{{ heading_title }}</h1>
          <p>{{ text_return_detail }}</p>
        </div>
        <div class="return-id-card">
          <span>{{ text_return_id }}</span>
          <strong>#{{ return_id }}</strong>
        </div>
      </section>

      <section class="return-summary-grid">
        <div class="return-summary">
          <span>{{ text_date_added }}</span>
          <strong>{{ date_added }}</strong>
        </div>
        <div class="return-summary">
          <span>{{ text_order_id }}</span>
          <strong>#{{ order_id }}</strong>
        </div>
        <div class="return-summary">
          <span>{{ text_date_ordered }}</span>
          <strong>{{ date_ordered }}</strong>
        </div>
      </section>

      <section class="return-panel">
        <div class="return-panel__head">
          <span class="return-panel__icon"><i class="fa fa-tag"></i></span>
          <div>
            <h2>{{ text_product }}</h2>
            <p>Talebe konu olan ürün bilgileri.</p>
          </div>
        </div>
        <div class="return-detail-grid">
          <div><span>{{ column_product }}</span><strong>{{ product }}</strong></div>
          <div><span>{{ column_model }}</span><strong>{{ model }}</strong></div>
          <div><span>{{ column_quantity }}</span><strong>{{ quantity }}</strong></div>
        </div>
      </section>

      <section class="return-panel">
        <div class="return-panel__head">
          <span class="return-panel__icon"><i class="fa fa-undo"></i></span>
          <div>
            <h2>{{ text_reason }}</h2>
            <p>İade nedeni ve ürün durumu.</p>
          </div>
        </div>
        {% set reason_label = reason %}
        {% if reason == 'Dead On Arrival' %}
        {% set reason_label = 'Ürün çalışmıyor' %}
        {% elseif reason == 'Faulty, please supply details' %}
        {% set reason_label = 'Arızalı, lütfen detay belirtin' %}
        {% elseif reason == 'Order Error' %}
        {% set reason_label = 'Sipariş hatası' %}
        {% elseif reason == 'Other, please supply details' %}
        {% set reason_label = 'Diğer, lütfen detay belirtin' %}
        {% elseif reason == 'Received Wrong Item' %}
        {% set reason_label = 'Yanlış ürün gönderildi' %}
        {% endif %}
        <div class="return-detail-grid">
          <div><span>{{ column_reason }}</span><strong>{{ reason_label }}</strong></div>
          <div><span>{{ column_opened }}</span><strong>{{ opened }}</strong></div>
          <div><span>{{ column_action }}</span><strong>{{ action }}</strong></div>
        </div>
        {% if comment %}
        <div class="return-comment">
          <span>{{ text_comment }}</span>
          <p>{{ comment }}</p>
        </div>
        {% endif %}
      </section>

      <section class="return-panel">
        <div class="return-panel__head">
          <span class="return-panel__icon"><i class="fa fa-clock-o"></i></span>
          <div>
            <h2>{{ text_history }}</h2>
            <p>Talebinizle ilgili son güncellemeler.</p>
          </div>
        </div>
        <div class="return-history">
          {% if histories %}
          {% for history in histories %}
          <article class="return-history__item">
            <time>{{ history.date_added }}</time>
            <strong>{{ history.status }}</strong>
            <p>{{ history.comment }}</p>
          </article>
          {% endfor %}
          {% else %}
          <div class="return-history__empty">{{ text_no_results }}</div>
          {% endif %}
        </div>
      </section>

      <div class="return-actions return-actions--right">
        <a href="{{ continue }}" class="btn btn-primary">{{ button_continue }} <i class="fa fa-angle-right"></i></a>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
