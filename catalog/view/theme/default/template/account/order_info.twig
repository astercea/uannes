{{ header }}
<div id="account-order" class="container account-page">
  {% if success %}
  <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}
  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
    <button type="button" class="close" data-dismiss="alert">&times;</button>
  </div>
  {% endif %}

  <style>
    /* ==========================================================================
       SIPARIS DETAYI / ORDER INFO REDESIGN
       ========================================================================== */
    #account-order #content {
      max-width: 1100px !important;
      width: 100% !important;
      margin: 0 auto;
    }

    .order-info-card {
      background: transparent;
      border: none;
      margin-bottom: 24px;
    }

    .order-info-card__header {
      background-color: #f5f2eb;
      padding: 14px 20px;
      border-bottom: 1px solid rgba(26, 26, 80, 0.12);
      font-family: 'DM Sans', sans-serif;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #1a1a50;
      text-align: center;
    }

    .order-info-card__body {
      padding: 20px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13.5px;
      color: #1a1a50;
      line-height: 1.7;
    }

    .order-info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-bottom: 24px;
    }

    @media (max-width: 768px) {
      .order-info-grid {
        grid-template-columns: 1fr;
        gap: 16px;
      }
    }

    /* Products Table (Desktop) */
    .order-info-products-desktop {
      display: block;
    }

    .order-info-products-mobile {
      display: none;
    }

    .order-info-table-wrap {
      border: none;
      background: transparent;
      margin-bottom: 28px;
      overflow-x: auto;
    }

    .order-info-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 0;
      font-family: 'DM Sans', sans-serif;
      color: #1a1a50;
    }

    .order-info-table thead tr {
      background-color: #f5f2eb !important;
      border-bottom: 1px solid rgba(26, 26, 80, 0.12) !important;
    }

    .order-info-table thead th,
    .order-info-table thead td {
      padding: 14px 16px !important;
      font-family: 'DM Sans', sans-serif !important;
      font-size: 11px !important;
      font-weight: 500 !important;
      letter-spacing: 0.08em !important;
      text-transform: uppercase !important;
      color: #1a1a50 !important;
      background: transparent !important;
      border: none !important;
      border-right: 1px solid rgba(26, 26, 80, 0.08) !important;
      white-space: nowrap;
      vertical-align: middle !important;
    }

    .order-info-table thead th:last-child,
    .order-info-table thead td:last-child {
      border-right: none !important;
    }

    .order-info-table tbody tr {
      border-bottom: 1px solid rgba(26, 26, 80, 0.08) !important;
    }

    .order-info-table tbody tr:last-child {
      border-bottom: none !important;
    }

    .order-info-table tbody td {
      padding: 16px !important;
      font-family: 'DM Sans', sans-serif !important;
      font-size: 13.5px !important;
      color: #1a1a50 !important;
      background: transparent !important;
      border: none !important;
      border-right: 1px solid rgba(26, 26, 80, 0.05) !important;
      vertical-align: middle !important;
    }

    .order-info-table tbody td:last-child {
      border-right: none !important;
    }

    .order-info-table tfoot tr {
      border: none !important;
      background: #fbf9f5 !important;
    }

    .order-info-table tfoot tr:first-child {
      border-top: 1px solid rgba(26, 26, 80, 0.08) !important;
    }

    .order-info-table tfoot td {
      padding: 8px 16px !important;
      font-family: 'DM Sans', sans-serif !important;
      font-size: 13.5px !important;
      color: #1a1a50 !important;
      border: none !important;
      border-right: none !important;
    }

    /* Minimal Action Links */
    .order-item-action {
      display: inline-block;
      color: #1a1a50 !important;
      font-size: 12.5px;
      font-weight: 500;
      margin-left: 10px;
      text-decoration: none !important;
      position: relative;
    }

    .order-item-action::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 100%;
      height: 1px;
      background-color: #1a1a50;
      transform: translateX(-50%) scaleX(0);
      transform-origin: center;
      transition: transform 0.25s ease;
    }

    .order-item-action:hover::after {
      transform: translateX(-50%) scaleX(1);
    }

    /* History Table Header */
    .history-heading {
      font-family: 'Cormorant Garamond', Georgia, serif;
      font-size: 22px;
      font-weight: 400;
      color: #1a1a50;
      margin-top: 35px;
      margin-bottom: 16px;
    }

    /* Back / Continue Button */
    .btn-back-custom {
      display: inline-block;
      padding: 10px 24px;
      background-color: #1a1a50;
      color: #ffffff !important;
      font-family: 'DM Sans', sans-serif;
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      text-decoration: none !important;
      border-radius: 0;
      transition: opacity 0.25s ease;
    }

    .btn-back-custom:hover {
      opacity: 0.85;
    }

    .order-info-prod-flex {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .order-info-prod-thumb {
      width: 60px;
      height: 60px;
      object-fit: cover;
      background: #f8f6f2;
      border: 1px solid rgba(26, 26, 80, 0.08);
      border-radius: 0;
      display: block;
      flex-shrink: 0;
    }

    .order-info-prod-title-link {
      font-family: 'DM Sans', sans-serif;
      font-weight: 500;
      font-size: 13.5px;
      color: #1a1a50 !important;
      text-decoration: none !important;
      display: block;
      line-height: 1.4;
      transition: color 0.2s ease;
    }

    .order-info-prod-title-link:hover {
      color: #725838 !important;
    }

    .order-info-prod-opt {
      font-size: 12px;
      color: rgba(26, 26, 80, 0.7);
      margin-top: 2px;
    }

    @media (max-width: 768px) {
      .order-info-products-desktop {
        display: none !important;
      }
      .order-info-products-mobile {
        display: flex !important;
        flex-direction: column;
        gap: 12px;
        margin-bottom: 24px;
      }
      .order-info-mobile-product-card {
        background: #ffffff;
        border: 1px solid rgba(26, 26, 80, 0.08);
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }
      .order-info-mobile-product-top {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .order-info-mobile-thumb {
        width: 70px;
        height: 70px;
        object-fit: cover;
        background: #f8f6f2;
        border: 1px solid rgba(26, 26, 80, 0.08);
        display: block;
        flex-shrink: 0;
      }
      .order-info-mobile-thumb-placeholder {
        width: 70px;
        height: 70px;
        background: #f5f2eb;
        border: 1px solid rgba(26, 26, 80, 0.08);
        display: flex;
        align-items: center;
        justify-content: center;
        color: rgba(26, 26, 80, 0.35);
        font-size: 22px;
        flex-shrink: 0;
      }
      .order-info-mobile-details {
        flex: 1;
        min-width: 0;
      }
      .order-info-mobile-product-title {
        font-family: 'DM Sans', sans-serif;
        font-size: 13.5px;
        font-weight: 500;
        color: #1a1a50 !important;
        text-decoration: none !important;
        display: block;
        line-height: 1.35;
        margin-bottom: 2px;
      }
      .order-info-mobile-model {
        font-size: 11.5px;
        color: rgba(26, 26, 80, 0.55);
        margin-top: 1px;
      }
      .order-info-mobile-product-options {
        font-size: 12px;
        color: rgba(26, 26, 80, 0.65);
        margin-top: 2px;
      }
      .order-info-mobile-product-bottom {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 10px;
        border-top: 1px solid rgba(26, 26, 80, 0.06);
      }
      .order-info-mobile-unit-qty {
        font-size: 12.5px;
        color: rgba(26, 26, 80, 0.7);
      }
      .order-info-mobile-item-total {
        font-size: 14.5px;
        font-weight: 700;
        color: #1a1a50;
      }
      .order-info-mobile-totals-card {
        background: #fbf9f5;
        border: 1px solid rgba(26, 26, 80, 0.08);
        padding: 14px 16px;
        margin-top: 14px;
      }
      .order-info-mobile-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 4px 0;
        font-size: 13px;
        color: #1a1a50;
      }
      .order-info-mobile-total-row:last-child {
        padding-top: 8px;
        margin-top: 6px;
        border-top: 1px solid rgba(26, 26, 80, 0.12);
        font-size: 15px;
        font-weight: 700;
      }
    }
  </style>

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      
      <!-- Order Summary Card -->
      <div class="order-info-card">
        <div class="order-info-card__header">{{ text_order_detail }}</div>
        <div class="order-info-card__body">
          <div class="row">
            <div class="col-sm-6">
              {% if invoice_no %}
                <b>{{ text_invoice_no }}</b> {{ invoice_no }}<br/>
              {% endif %}
              <b>{{ text_order_id }}</b> #{{ order_id }}<br/>
              <b>{{ text_date_added }}</b> {{ date_added }}
            </div>
            <div class="col-sm-6">
              {% if payment_method %}
                <b>{{ text_payment_method }}</b> {{ payment_method }}<br/>
              {% endif %}
              {% if shipping_method %}
                <b>{{ text_shipping_method }}</b> {{ shipping_method }}
              {% endif %}
            </div>
          </div>
        </div>
      </div>

      <!-- Address Cards Grid -->
      <div class="order-info-grid">
        <div class="order-info-card mb-0">
          <div class="order-info-card__header">{{ text_payment_address }}</div>
          <div class="order-info-card__body">
            {{ payment_address }}
          </div>
        </div>
        {% if shipping_address %}
        <div class="order-info-card mb-0">
          <div class="order-info-card__header">{{ text_shipping_address }}</div>
          <div class="order-info-card__body">
            {{ shipping_address }}
          </div>
        </div>
        {% endif %}
      </div>

      <!-- 1) Products Table (Desktop) -->
      <div class="order-info-products-desktop">
        <div class="order-info-table-wrap">
          <table class="table order-info-table">
            <thead>
              <tr>
                <th class="text-left">{{ column_name }}</th>
                <th class="text-left">{{ column_model }}</th>
                <th class="text-center">{{ column_quantity }}</th>
                <th class="text-right">{{ column_price }}</th>
                <th class="text-right">{{ column_total }}</th>
                {% if products %}
                <th class="text-center" style="width: 110px;"></th>
                {% endif %}
              </tr>
            </thead>
            <tbody>
            {% for product in products %}
            <tr>
              <td class="text-left">
                <div class="order-info-prod-flex">
                  {% if product.thumb %}
                    <a href="{{ product.href|default('#') }}">
                      <img src="{{ product.thumb }}" alt="{{ product.name }}" class="order-info-prod-thumb">
                    </a>
                  {% endif %}
                  <div>
                    {% if product.href %}
                      <a href="{{ product.href }}" class="order-info-prod-title-link">{{ product.name }}</a>
                    {% else %}
                      <div class="order-info-prod-title-link">{{ product.name }}</div>
                    {% endif %}
                    {% for option in product.option %}
                      <div class="order-info-prod-opt">{{ option.name }}: {{ option.value }}</div>
                    {% endfor %}
                  </div>
                </div>
              </td>
              <td class="text-left">
                {% if product.model %}
                  {% if product.model starts with '#' %}{{ product.model }}{% else %}#{{ product.model }}{% endif %}
                {% endif %}
              </td>
              <td class="text-center">{{ product.quantity }}</td>
              <td class="text-right">{{ product.price }}</td>
              <td class="text-right">{{ product.total }}</td>
              <td class="text-center" style="white-space: nowrap;">
                {% if product.return %}
                  <a href="{{ product.return }}" class="order-item-action" title="{{ button_return }}">İade Et</a>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
            {% for voucher in vouchers %}
            <tr>
              <td class="text-left">{{ voucher.description }}</td>
              <td class="text-left"></td>
              <td class="text-center">1</td>
              <td class="text-right">{{ voucher.amount }}</td>
              <td class="text-right">{{ voucher.amount }}</td>
              {% if products %}
              <td></td>
              {% endif %}
            </tr>
            {% endfor %}
            </tbody>
            
            <tfoot>
            {% for total in totals %}
            <tr>
              <td colspan="3"></td>
              <td class="text-right"><b>{{ total.title }}:</b></td>
              <td class="text-right"><b>{{ total.text }}</b></td>
              {% if products %}
              <td></td>
              {% endif %}
            </tr>
            {% endfor %}
            </tfoot>
          </table>
        </div>
      </div>

      <!-- 2) Products Cards (Mobile) -->
      <div class="order-info-products-mobile">
        <div class="order-info-card__header" style="margin-bottom: 4px;">ÜRÜNLER</div>
        {% for product in products %}
        <div class="order-info-mobile-product-card">
          <div class="order-info-mobile-product-top">
            {% if product.thumb %}
              <a href="{{ product.href|default('#') }}">
                <img src="{{ product.thumb }}" alt="{{ product.name }}" class="order-info-mobile-thumb">
              </a>
            {% else %}
              <div class="order-info-mobile-thumb-placeholder">
                <i class="fa fa-shopping-bag"></i>
              </div>
            {% endif %}

            <div class="order-info-mobile-details">
              {% if product.href %}
                <a href="{{ product.href }}" class="order-info-mobile-product-title">{{ product.name }}</a>
              {% else %}
                <div class="order-info-mobile-product-title">{{ product.name }}</div>
              {% endif %}
              {% if product.model %}
                <div class="order-info-mobile-model">Kod: {% if product.model starts with '#' %}{{ product.model }}{% else %}#{{ product.model }}{% endif %}</div>
              {% endif %}
              {% for option in product.option %}
                <div class="order-info-mobile-product-options">{{ option.name }}: {{ option.value }}</div>
              {% endfor %}
            </div>
          </div>

          <div class="order-info-mobile-product-bottom">
            <span class="order-info-mobile-unit-qty">{{ product.quantity }} Adet × {{ product.price }}</span>
            <div style="display: flex; align-items: center; gap: 8px;">
              <span class="order-info-mobile-item-total">{{ product.total }}</span>
              {% if product.return %}
                <a href="{{ product.return }}" class="btn-back-custom" style="padding: 5px 10px; font-size: 10.5px;">İade Et</a>
              {% endif %}
            </div>
          </div>
        </div>
        {% endfor %}
        {% for voucher in vouchers %}
        <div class="order-info-mobile-product-card">
          <div class="order-info-mobile-product-title">{{ voucher.description }}</div>
          <div class="order-info-mobile-product-bottom">
            <span class="order-info-mobile-unit-qty">1 Adet</span>
            <span class="order-info-mobile-item-total">{{ voucher.amount }}</span>
          </div>
        </div>
        {% endfor %}

        <!-- Mobile Totals -->
        <div class="order-info-mobile-totals-card">
          {% for total in totals %}
          <div class="order-info-mobile-total-row">
            <span>{{ total.title }}</span>
            <span style="font-weight: 600;">{{ total.text }}</span>
          </div>
          {% endfor %}
        </div>
      </div>

      {% if comment %}
      <div class="order-info-card">
        <div class="order-info-card__header">{{ text_comment }}</div>
        <div class="order-info-card__body">
          {{ comment }}
        </div>
      </div>
      {% endif %}

      {% if histories %}
      <h3 class="history-heading">{{ text_history }}</h3>
      <div class="order-info-table-wrap">
        <table class="table order-info-table">
          <thead>
            <tr>
              <th class="text-left" style="width: 25%;">{{ column_date_added }}</th>
              <th class="text-left" style="width: 25%;">{{ column_status }}</th>
              <th class="text-left" style="width: 50%;">{{ column_comment }}</th>
            </tr>
          </thead>
          <tbody>
          {% for history in histories %}
            {% set h_status_tr = history.status %}
            {% if history.status in ['Pending','Beklemede','On Hold','Bekliyor','Pending Payment','Pending Verification'] %}
              {% set h_status_tr = 'Beklemede' %}
            {% elseif history.status in ['Processing','Processed','Processing Payment','İşleniyor','Hazırlanıyor'] %}
              {% set h_status_tr = 'İşleniyor' %}
            {% elseif history.status in ['Shipped','Kargoda','Gönderildi','Kargoya Verildi'] %}
              {% set h_status_tr = 'Kargoya Verildi' %}
            {% elseif history.status in ['Delivered','Teslim Edildi'] %}
              {% set h_status_tr = 'Teslim Edildi' %}
            {% elseif history.status in ['Completed','Complete','Tamamlandı','Bitti'] %}
              {% set h_status_tr = 'Tamamlandı' %}
            {% elseif history.status in ['Canceled','Cancelled','İptal Edildi','İptal'] %}
              {% set h_status_tr = 'İptal Edildi' %}
            {% elseif history.status in ['Refunded','İade Edildi','Returned'] %}
              {% set h_status_tr = 'İade Edildi' %}
            {% elseif history.status in ['On Hold','Hold','Bekletiliyor'] %}
              {% set h_status_tr = 'Bekletiliyor' %}
            {% endif %}

          <tr>
            <td class="text-left">{{ history.date_added }}</td>
            <td class="text-left">{{ h_status_tr }}</td>
            <td class="text-left">{{ history.comment }}</td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>
{{ footer }}
