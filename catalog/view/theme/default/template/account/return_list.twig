{{ header }}
<div id="account-return" class="container return-page return-page--list">
  <ul class="breadcrumb return-breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">{{ content_top }}
      <section class="return-hero return-hero--compact">
        <div class="return-hero__content">
          <span class="return-eyebrow">Uannes Care</span>
          <h1>{{ heading_title }}</h1>
          <p>İade ve değişim taleplerinizi tek ekrandan takip edin.</p>
        </div>
      </section>

      {% if returns %}
      <section class="return-panel">
        <div class="return-panel__head">
          <span class="return-panel__icon"><i class="fa fa-list-ul"></i></span>
          <div>
            <h2>{{ heading_title }}</h2>
            <p>{{ results }}</p>
          </div>
        </div>

        <div class="return-table-wrap">
          <table class="table return-table">
            <thead>
              <tr>
                <th class="text-left">{{ column_return_id }}</th>
                <th class="text-left">{{ column_status }}</th>
                <th class="text-left">{{ column_date_added }}</th>
                <th class="text-left">{{ column_order_id }}</th>
                <th class="text-left">{{ column_customer }}</th>
                <th class="text-right"></th>
              </tr>
            </thead>
            <tbody>
            {% for return in returns %}
              <tr>
                <td data-label="{{ column_return_id }}"><strong>#{{ return.return_id }}</strong></td>
                <td data-label="{{ column_status }}"><span class="return-status">{{ return.status }}</span></td>
                <td data-label="{{ column_date_added }}">{{ return.date_added }}</td>
                <td data-label="{{ column_order_id }}">#{{ return.order_id }}</td>
                <td data-label="{{ column_customer }}">{{ return.name }}</td>
                <td class="text-right return-table__action">
                  <a href="{{ return.href }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-info return-icon-btn"><i class="fa fa-eye"></i></a>
                </td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
      </section>

      <div class="return-pagination">
        <div>{{ pagination }}</div>
        <div>{{ results }}</div>
      </div>
      {% else %}
      <section class="return-empty">
        <span class="return-empty__icon"><i class="fa fa-refresh"></i></span>
        <h2>{{ text_empty }}</h2>
        <p>İade veya değişim talebiniz oluştuğunda burada görünecek.</p>
      </section>
      {% endif %}

      <div class="return-actions return-actions--right">
        <a href="{{ continue }}" class="btn btn-primary">{{ button_continue }} <i class="fa fa-angle-right"></i></a>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
