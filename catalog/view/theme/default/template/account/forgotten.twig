{{ header }}
<style>
  body { background-color: #f8f6f2; }
  footer { margin-top: 0; }
  
  .login-page {
    padding-top: 60px;
    padding-bottom: 100px;
    min-height: calc(100vh - 80px);
  }
  .login-page__form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .login-field {
    position: relative;
    margin-bottom: 24px;
    background: transparent;
  }
  .login-field__input {
    width: 100%;
    height: 46px;
    border: none !important;
    border-bottom: 1px solid #c8c8c8 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    background-color: transparent !important;
    padding: 22px 8px 4px 8px !important;
    font-family: 'Open Sans', 'DM Sans', sans-serif !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    color: #1a1a50 !important;
    outline: none !important;
    box-sizing: border-box;
    -webkit-appearance: none;
    line-height: 1.4;
    transition: border-color 0.3s ease;
  }
  .login-field__input:focus {
    border-bottom-color: #1a1a50 !important;
    background: transparent !important;
    background-color: transparent !important;
    outline: none !important;
  }
  .login-field__input:-webkit-autofill,
  .login-field__input:-webkit-autofill:hover,
  .login-field__input:-webkit-autofill:focus,
  .login-field__input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0px 1000px #f8f6f2 inset !important;
    box-shadow: 0 0 0px 1000px #f8f6f2 inset !important;
    -webkit-text-fill-color: #1a1a50 !important;
    background-color: transparent !important;
    transition: background-color 5000s ease-in-out 0s !important;
  }
  .login-field__label {
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'Open Sans', 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    pointer-events: none;
    margin: 0;
    transition: top 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
      font-size 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
      color 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
      transform 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
    transform-origin: left top;
  }
  .login-field.required > .login-field__label::after {
    content: ' *';
    color: #c53030;
  }
  .login-field__input:focus + .login-field__label,
  .login-field__input:not(:placeholder-shown) + .login-field__label {
    top: 0px;
    transform: translateY(0);
    font-size: 9.5px;
    color: #999;
    letter-spacing: 0.04em;
  }

  @media (max-width: 575.98px) {
    .login-page {
      padding-top: 35px;
      padding-bottom: 70px;
      min-height: calc(100vh - 60px);
    }
    .login-page__container {
      padding: 0 15px;
      max-width: 100%;
    }
    .login-page__title {
      font-size: 22px !important;
      margin-bottom: 0.75rem !important;
      letter-spacing: 0.12em;
    }
    .login-page__subtitle {
      font-size: 13px !important;
      line-height: 1.55 !important;
      margin-bottom: 1.75rem !important;
    }
    .login-field {
      margin-bottom: 20px;
    }
    .login-field__input {
      height: 44px;
      padding: 20px 6px 3px 6px !important;
      font-size: 13px !important;
    }
    .login-field__label {
      left: 6px;
      font-size: 11.5px;
    }
    .login-field__input:focus + .login-field__label,
    .login-field__input:not(:placeholder-shown) + .login-field__label {
      font-size: 9px;
    }
    .login-page__submit {
      padding: 10px 16px !important;
      font-size: 13px !important;
      letter-spacing: 0.1em !important;
    }
  }
</style>
<div id="account-forgotten" class="login-page">
  <div class="container">
    <div class="login-page__container">
    
    {% if error_warning %}
    <div class="login-alert login-alert--error">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7.5" stroke="currentColor"/><path d="M8 5v4M8 11h.01" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
      <span>{{ error_warning }}</span>
    </div>
    {% endif %}

    <h1 class="login-page__title">Şifreni mi unuttun?</h1>
    <p class="login-page__subtitle" style="margin: 0 auto 2.5rem; max-width: 95%;">Sıfırlama bağlantısı için kayıtlı e-posta adresinizi giriniz.</p>

    <form action="{{ action }}" method="post" enctype="multipart/form-data" class="login-page__form" autocomplete="off">
      <div class="login-field required">
        <input type="email" name="email" value="{{ email }}" id="input-email" class="login-field__input" placeholder=" " required autocomplete="email" />
        <label for="input-email" class="login-field__label">E-posta Adresi</label>
      </div>

      <button type="submit" class="login-page__submit" style="margin-top: 1rem;">
        <span>Gönder</span>
      </button>

      <div style="text-align: center; margin-top: 2rem;">
        <a href="{{ back }}" class="login-page__forgot-link" style="font-size: 13.5px; border-bottom: none; letter-spacing: 0.05em;">Giriş Sayfasına Dön</a>
      </div>
    </form>

    </div>
  </div>
</div>
{{ footer }}
