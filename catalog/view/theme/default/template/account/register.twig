{{ header }}
<style>
  body { background-color: #f8f6f2; }
  footer { margin-top: 0; }
  
  .login-page {
    padding-top: 60px;
    padding-bottom: 100px;
    min-height: calc(100vh - 80px);
  }
  .login-page__form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .login-field {
    position: relative;
    margin-bottom: 24px;
    background: transparent;
  }
  .login-field__input {
    width: 100%;
    height: 46px;
    border: none !important;
    border-bottom: 1px solid #c8c8c8 !important;
    border-radius: 0 !important;
    box-shadow: none !important;
    background: transparent !important;
    background-color: transparent !important;
    padding: 22px 8px 4px 8px !important;
    font-family: 'Open Sans', 'DM Sans', sans-serif !important;
    font-size: 13px !important;
    font-weight: 400 !important;
    color: #1a1a50 !important;
    outline: none !important;
    box-sizing: border-box;
    -webkit-appearance: none;
    line-height: 1.4;
    transition: border-color 0.3s ease;
  }
  .login-field__input:focus {
    border-bottom-color: #1a1a50 !important;
    background: transparent !important;
    background-color: transparent !important;
    outline: none !important;
  }
  .login-field__input:-webkit-autofill,
  .login-field__input:-webkit-autofill:hover,
  .login-field__input:-webkit-autofill:focus,
  .login-field__input:-webkit-autofill:active {
    -webkit-box-shadow: 0 0 0px 1000px #f8f6f2 inset !important;
    box-shadow: 0 0 0px 1000px #f8f6f2 inset !important;
    -webkit-text-fill-color: #1a1a50 !important;
    background-color: transparent !important;
    transition: background-color 5000s ease-in-out 0s !important;
  }
  .login-field__label {
    position: absolute;
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
    font-family: 'Open Sans', 'DM Sans', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: #999;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    pointer-events: none;
    margin: 0;
    transition: top 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
      font-size 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
      color 0.25s cubic-bezier(0.25, 0.8, 0.25, 1),
      transform 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
    transform-origin: left top;
  }
  .login-field.required > .login-field__label::after {
    content: ' *';
    color: #c53030;
  }
  .login-page__submit {
    display: block;
    width: 100%;
    padding: 11px 20px !important;
    background-color: #1a1a50 !important;
    background-image: none !important;
    color: #fff !important;
    border: 1.5px solid #1a1a50 !important;
    font-family: 'Open Sans', 'DM Sans', sans-serif !important;
    font-size: 13.5px !important;
    font-weight: 500 !important;
    letter-spacing: 0.12em !important;
    text-transform: uppercase !important;
    cursor: pointer;
    transition: background 0.35s ease, color 0.35s ease;
    -webkit-appearance: none;
    border-radius: 0 !important;
  }
  .login-page__submit:hover {
    background-color: #fff !important;
    color: #1a1a50 !important;
  }
  .login-field__input:focus + .login-field__label,
  .login-field__input:not(:placeholder-shown) + .login-field__label {
    top: 0px;
    transform: translateY(0);
    font-size: 9.5px;
    color: #999;
    letter-spacing: 0.04em;
  }
  .login-page__agree {
    margin-top: 1.25rem;
    margin-bottom: 2.5rem;
    margin-left: 2px;
  }
  .custom-checkbox-container {
    display: inline-flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    user-select: none;
    font-family: 'Open Sans', 'DM Sans', sans-serif;
    font-size: 13px;
    color: #555;
    line-height: 1.5;
    margin: 0;
  }
  .custom-checkbox-container input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    cursor: pointer;
    height: 0;
    width: 0;
  }
  .custom-checkbox-checkmark {
    position: relative;
    top: 2px;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    background-color: transparent;
    border: 1px solid #1a1a50;
    border-radius: 0;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }
  .custom-checkbox-container:hover input ~ .custom-checkbox-checkmark {
    border-color: #1a1a50;
    background-color: rgba(26, 26, 80, 0.04);
  }
  .custom-checkbox-container input:checked ~ .custom-checkbox-checkmark {
    background-color: #1a1a50;
    border-color: #1a1a50;
  }
  .custom-checkbox-checkmark::after {
    content: "";
    position: absolute;
    display: none;
    left: 4px;
    top: 1px;
    width: 5px;
    height: 9px;
    border: solid #ffffff;
    border-width: 0 1.5px 1.5px 0;
    transform: rotate(45deg);
  }
  .custom-checkbox-container input:checked ~ .custom-checkbox-checkmark::after {
    display: block;
  }
  .custom-checkbox-text {
    font-size: 12.5px;
    color: #555;
    line-height: 1.45;
  }
  .custom-checkbox-text a {
    color: #1a1a50;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 575.98px) {
    .login-page {
      padding-top: 35px;
      padding-bottom: 70px;
      min-height: calc(100vh - 60px);
    }
    .login-page__container {
      padding: 0 15px;
      max-width: 100%;
    }
    .login-page__title {
      font-size: 22px !important;
      margin-bottom: 1.5rem !important;
      letter-spacing: 0.12em;
    }
    .login-field {
      margin-bottom: 20px;
    }
    .login-field__input {
      height: 44px;
      padding: 20px 6px 3px 6px !important;
      font-size: 13px !important;
    }
    .login-field__label {
      left: 6px;
      font-size: 11.5px;
    }
    .login-field__input:focus + .login-field__label,
    .login-field__input:not(:placeholder-shown) + .login-field__label {
      font-size: 9px;
    }
    .login-page__submit {
      padding: 10px 16px !important;
      font-size: 13px !important;
      letter-spacing: 0.1em !important;
    }
    .login-page__agree {
      margin-top: 1rem;
      margin-bottom: 2rem;
    }
    .custom-checkbox-text {
      font-size: 12px;
      line-height: 1.4;
    }
  }
</style>

<div id="account-register" class="login-page">
  <div class="container">
    <div class="login-page__container">

      {% if error_warning %}
      <div class="login-alert login-alert--error">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="7.5" stroke="currentColor"/><path d="M8 5v4M8 11h.01" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg>
        <span>{{ error_warning }}</span>
      </div>
      {% endif %}

      <h1 class="login-page__title" style="margin-bottom: 2.5rem;">{{ heading_title }}</h1>

      <form action="{{ action }}" method="post" enctype="multipart/form-data" class="login-page__form" autocomplete="off">
        <fieldset id="account" style="border:none; padding:0; margin:0;">
          
          <div class="login-field" style="display: {% if customer_groups|length > 1 %} block {% else %} none {% endif %};">
            <label class="login-field__label" style="position:static; transform:none; margin-bottom:8px; display:block;">{{ entry_customer_group }}</label>
            <div>
              {% for customer_group in customer_groups %}
              {% if customer_group.customer_group_id == customer_group_id %}
              <label style="margin-right: 15px; font-size:13.5px; color:#1a1a50; cursor:pointer;">
                <input type="radio" name="customer_group_id" value="{{ customer_group.customer_group_id }}" checked="checked" />
                {{ customer_group.name }}
              </label>
              {% else %}
              <label style="margin-right: 15px; font-size:13.5px; color:#1a1a50; cursor:pointer;">
                <input type="radio" name="customer_group_id" value="{{ customer_group.customer_group_id }}" />
                {{ customer_group.name }}
              </label>
              {% endif %}
              {% endfor %}
            </div>
          </div>

          <div class="login-field required">
            <input type="text" name="firstname" value="{{ firstname }}" placeholder=" " id="input-firstname" class="login-field__input" />
            <label for="input-firstname" class="login-field__label">{{ entry_firstname }}</label>
            {% if error_firstname %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_firstname }}</div>
            {% endif %}
          </div>

          <div class="login-field required">
            <input type="text" name="lastname" value="{{ lastname }}" placeholder=" " id="input-lastname" class="login-field__input" />
            <label for="input-lastname" class="login-field__label">{{ entry_lastname }}</label>
            {% if error_lastname %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_lastname }}</div>
            {% endif %}
          </div>

          <div class="login-field required">
            <input type="email" name="email" value="{{ email }}" placeholder=" " id="input-email" class="login-field__input" />
            <label for="input-email" class="login-field__label">{{ entry_email }}</label>
            {% if error_email %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_email }}</div>
            {% endif %}
          </div>

          <div class="login-field required">
            <input type="tel" name="telephone" value="{{ telephone }}" placeholder=" " id="input-telephone" class="login-field__input" />
            <label for="input-telephone" class="login-field__label">{{ entry_telephone }}</label>
            {% if error_telephone %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_telephone }}</div>
            {% endif %}
          </div>

          {% for custom_field in custom_fields %}
          <!-- Custom fields logic kept identical but styled slightly for the new form layout -->
          {% if custom_field.type == 'select' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field" data-sort="{{ custom_field.sort_order }}">
            <label class="login-field__label" style="position:static; transform:none; margin-bottom:8px; display:block;" for="input-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}</label>
            <select name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" id="input-custom-field{{ custom_field.custom_field_id }}" class="login-field__input" style="padding: 10px 0;">
              <option value="">{{ text_select }}</option>
              {% for custom_field_value in custom_field.custom_field_value %}
              {% if register_custom_field[custom_field.location][custom_field.custom_field_id] and custom_field_value.custom_field_value_id == register_custom_field[custom_field.custom_field_id] %}
              <option value="{{ custom_field_value.custom_field_value_id }}" selected="selected">{{ custom_field_value.name }}</option>
              {% else %}
              <option value="{{ custom_field_value.custom_field_value_id }}">{{ custom_field_value.name }}</option>
              {% endif %}
              {% endfor %}
            </select>
            <span class="login-field__line"></span>
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          
          {% if custom_field.type == 'radio' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field" data-sort="{{ custom_field.sort_order }}">
            <label class="login-field__label" style="position:static; transform:none; margin-bottom:8px; display:block;">{{ custom_field.name }}</label>
            <div>
              {% for custom_field_value in custom_field.custom_field_value %}
              <label style="margin-right: 15px; font-size:13.5px; color:#1a1a50; cursor:pointer;">
                {% if register_custom_field[custom_field.custom_field_id] and custom_field_value.custom_field_value_id == register_custom_field[custom_field.custom_field_id] %}
                <input type="radio" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id }}" checked="checked" />
                {% else %}
                <input type="radio" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{{ custom_field_value.custom_field_value_id }}" />
                {% endif %}
                {{ custom_field_value.name }}
              </label>
              {% endfor %}
            </div>
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          
          {% if custom_field.type == 'checkbox' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field" data-sort="{{ custom_field.sort_order }}">
            <label class="login-field__label" style="position:static; transform:none; margin-bottom:8px; display:block;">{{ custom_field.name }}</label>
            <div>
              {% for custom_field_value in custom_field.custom_field_value %}
              <label style="margin-right: 15px; font-size:13.5px; color:#1a1a50; cursor:pointer; display:block; margin-bottom:4px;">
                {% if register_custom_field[custom_field.custom_field_id] and custom_field_value.custom_field_value_id in register_custom_field[custom_field.custom_field_id] %}
                <input type="checkbox" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}][]" value="{{ custom_field_value.custom_field_value_id }}" checked="checked" />
                {% else %}
                <input type="checkbox" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}][]" value="{{ custom_field_value.custom_field_value_id }}" />
                {% endif %}
                {{ custom_field_value.name }}
              </label>
              {% endfor %}
            </div>
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          
          {% if custom_field.type == 'text' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field" data-sort="{{ custom_field.sort_order }}">
            <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if register_custom_field[custom_field.custom_field_id] %}{{ register_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder=" " id="input-custom-field{{ custom_field.custom_field_id }}" class="login-field__input" />
            <label class="login-field__label" for="input-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}</label>
            <span class="login-field__line"></span>
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          
          {% if custom_field.type == 'textarea' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field" data-sort="{{ custom_field.sort_order }}">
            <textarea name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" rows="2" placeholder=" " id="input-custom-field{{ custom_field.custom_field_id }}" class="login-field__input" style="padding-top:14px; resize:vertical;">{% if register_custom_field[custom_field.custom_field_id] %}{{ register_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}</textarea>
            <label class="login-field__label" style="top:14px; transform:none;" for="input-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}</label>
            <span class="login-field__line"></span>
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          
          {% if custom_field.type == 'file' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field" data-sort="{{ custom_field.sort_order }}">
            <label class="login-field__label" style="position:static; transform:none; margin-bottom:8px; display:block;">{{ custom_field.name }}</label>
            <button type="button" id="button-custom-field{{ custom_field.custom_field_id }}" data-loading-text="{{ text_loading }}" class="login-page__submit" style="padding:10px 15px; font-size:12px; display:inline-block; width:auto; border-radius:0;">{{ button_upload }}</button>
            <input type="hidden" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if register_custom_field[custom_field.custom_field_id] %}  {{ register_custom_field[custom_field.custom_field_id] }} {% endif %}" />
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          
          {% if custom_field.type == 'date' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field date" data-sort="{{ custom_field.sort_order }}">
            <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if register_custom_field[custom_field.custom_field_id] %}{{ register_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder=" " data-date-format="YYYY-MM-DD" id="input-custom-field{{ custom_field.custom_field_id }}" class="login-field__input" />
            <label class="login-field__label" for="input-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}</label>
            <span class="login-field__line"></span>
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          
          {% if custom_field.type == 'time' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field time" data-sort="{{ custom_field.sort_order }}">
            <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if register_custom_field[custom_field.custom_field_id] %}{{ register_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder=" " data-date-format="HH:mm" id="input-custom-field{{ custom_field.custom_field_id }}" class="login-field__input" />
            <label class="login-field__label" for="input-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}</label>
            <span class="login-field__line"></span>
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          
          {% if custom_field.type == 'datetime' %}
          <div id="custom-field{{ custom_field.custom_field_id }}" class="login-field custom-field datetime" data-sort="{{ custom_field.sort_order }}">
            <input type="text" name="custom_field[{{ custom_field.location }}][{{ custom_field.custom_field_id }}]" value="{% if register_custom_field[custom_field.custom_field_id] %}{{ register_custom_field[custom_field.custom_field_id] }}{% else %}{{ custom_field.value }}{% endif %}" placeholder=" " data-date-format="YYYY-MM-DD HH:mm" id="input-custom-field{{ custom_field.custom_field_id }}" class="login-field__input" />
            <label class="login-field__label" for="input-custom-field{{ custom_field.custom_field_id }}">{{ custom_field.name }}</label>
            <span class="login-field__line"></span>
            {% if error_custom_field[custom_field.custom_field_id] %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_custom_field[custom_field.custom_field_id] }}</div>
            {% endif %}
          </div>
          {% endif %}
          {% endfor %}

        </fieldset>

        <fieldset style="border:none; padding:0; margin:0;">
          <div class="login-field required">
            <input type="password" name="password" value="{{ password }}" placeholder=" " id="input-password" class="login-field__input" />
            <label for="input-password" class="login-field__label">{{ entry_password }}</label>
            {% if error_password %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_password }}</div>
            {% endif %}
          </div>

          <div class="login-field required">
            <input type="password" name="confirm" value="{{ confirm }}" placeholder=" " id="input-confirm" class="login-field__input" />
            <label for="input-confirm" class="login-field__label">{{ entry_confirm }}</label>
            {% if error_confirm %}
            <div class="text-danger" style="font-size:11px; color:#d9534f; margin-top:4px;">{{ error_confirm }}</div>
            {% endif %}
          </div>
        </fieldset>

        <!-- Newsletter gizlendi, varsayılan 0 olarak gönderiliyor -->
        <input type="hidden" name="newsletter" value="0" />

        {{ captcha }}
        
        {% if text_agree %}
        <div class="login-page__agree">
          <label class="custom-checkbox-container" for="agree-checkbox">
            <input type="checkbox" name="agree" value="1" id="agree-checkbox"{% if agree %} checked="checked"{% endif %} />
            <span class="custom-checkbox-checkmark"></span>
            <span class="custom-checkbox-text">{{ text_agree }}</span>
          </label>
        </div>
        {% endif %}

        <button type="submit" class="login-page__submit">
          <span>Devam Et</span>
        </button>

      </form>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
// Sort the custom fields
$('#account .login-field[data-sort]').detach().each(function() {
	if ($(this).attr('data-sort') >= 0 && $(this).attr('data-sort') <= $('#account .login-field').length) {
		$('#account .login-field').eq($(this).attr('data-sort')).before(this);
	}
	if ($(this).attr('data-sort') > $('#account .login-field').length) {
		$('#account .login-field:last').after(this);
	}
	if ($(this).attr('data-sort') == $('#account .login-field').length) {
		$('#account .login-field:last').after(this);
	}
	if ($(this).attr('data-sort') < -$('#account .login-field').length) {
		$('#account .login-field:first').before(this);
	}
});

$('input[name=\'customer_group_id\']').on('change', function() {
	$.ajax({
		url: 'index.php?route=account/register/customfield&customer_group_id=' + this.value,
		dataType: 'json',
		success: function(json) {
			$('.custom-field').hide();
			$('.custom-field').removeClass('required');

			for (i = 0; i < json.length; i++) {
				custom_field = json[i];

				$('#custom-field' + custom_field['custom_field_id']).show();

				if (custom_field['required']) {
					$('#custom-field' + custom_field['custom_field_id']).addClass('required');
				}
			}
