{{ header }}
<div id="account-return" class="container return-page return-page--form">
  <ul class="breadcrumb return-breadcrumb">
    {% for breadcrumb in breadcrumbs %}
    <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
    {% endfor %}
  </ul>

  {% if error_warning %}
  <div class="alert alert-danger alert-dismissible return-alert"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
  {% endif %}

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">{{ content_top }}
      <section class="return-hero return-hero--title-only">
        <h1>İADE TALEBİ OLUŞTURUN</h1>
      </section>

      <form action="{{ action }}" method="post" enctype="multipart/form-data" class="return-form">
        <section class="return-panel">
          <div class="return-panel__head">
            <span class="return-panel__icon"><i class="fa fa-file-text-o"></i></span>
            <div>
              <h2>{{ text_order }}</h2>
              <p>Sipariş ve iletişim bilgilerinizi eksiksiz girin.</p>
            </div>
          </div>

          <div class="return-grid">
            <div class="return-field return-float required">
              <input type="text" name="firstname" value="{{ firstname }}" placeholder=" " id="input-firstname" class="form-control" />
              <label for="input-firstname">{{ entry_firstname }}</label>
              {% if error_firstname %}<div class="text-danger">{{ error_firstname }}</div>{% endif %}
            </div>
            <div class="return-field return-float required">
              <input type="text" name="lastname" value="{{ lastname }}" placeholder=" " id="input-lastname" class="form-control" />
              <label for="input-lastname">{{ entry_lastname }}</label>
              {% if error_lastname %}<div class="text-danger">{{ error_lastname }}</div>{% endif %}
            </div>
            <div class="return-field return-float required">
              <input type="text" name="email" value="{{ email }}" placeholder=" " id="input-email" class="form-control" />
              <label for="input-email">{{ entry_email }}</label>
              {% if error_email %}<div class="text-danger">{{ error_email }}</div>{% endif %}
            </div>
            <div class="return-field return-float required">
              <input type="text" name="telephone" value="{{ telephone }}" placeholder=" " id="input-telephone" class="form-control" />
              <label for="input-telephone">{{ entry_telephone }}</label>
              {% if error_telephone %}<div class="text-danger">{{ error_telephone }}</div>{% endif %}
            </div>
            <div class="return-field return-float required">
              <input type="text" name="order_id" value="{{ order_id }}" placeholder=" " id="input-order-id" class="form-control" />
              <label for="input-order-id">{{ entry_order_id }}</label>
              {% if error_order_id %}<div class="text-danger">{{ error_order_id }}</div>{% endif %}
            </div>
            <div class="return-field return-float">
              <div class="input-group date return-date">
                <input type="text" name="date_ordered" value="{{ date_ordered }}" placeholder=" " data-date-format="YYYY-MM-DD" id="input-date-ordered" class="form-control" />
                <label for="input-date-ordered">{{ entry_date_ordered }}</label>
                <span class="input-group-btn">
                <button type="button" class="btn btn-default" aria-label="{{ entry_date_ordered }}"><i class="fa fa-calendar"></i></button>
                </span>
              </div>
            </div>
          </div>
        </section>

        <section class="return-panel">
          <div class="return-panel__head">
            <span class="return-panel__icon"><i class="fa fa-tag"></i></span>
            <div>
              <h2>{{ text_product }}</h2>
              <p>Ürünü, iade nedenini ve ek detayları belirtin.</p>
            </div>
          </div>

          <div class="return-grid">
            <div class="return-field return-float required">
              <input type="text" name="product" value="{{ product }}" placeholder=" " id="input-product" class="form-control" />
              <label for="input-product">{{ entry_product }}</label>
              <input type="hidden" name="product_id" value="{{ product_id }}" />
              {% if error_product %}<div class="text-danger">{{ error_product }}</div>{% endif %}
            </div>
            <div class="return-field return-float required">
              <input type="text" name="model" value="{{ model }}" placeholder=" " id="input-model" class="form-control" />
              <label for="input-model">{{ entry_model }}</label>
              {% if error_model %}<div class="text-danger">{{ error_model }}</div>{% endif %}
            </div>
            <div class="return-field return-float">
              <input type="text" name="quantity" value="{{ quantity }}" placeholder=" " id="input-quantity" class="form-control" />
              <label for="input-quantity">{{ entry_quantity }}</label>
            </div>
            <div class="return-field required return-field--wide">
              <label>{{ entry_reason }}</label>
              <div class="return-choice-grid">
                {% for return_reason in return_reasons %}
                {% set reason_name = return_reason.name %}
                {% if return_reason.name == 'Dead On Arrival' %}
                {% set reason_name = 'Ürün çalışmıyor' %}
                {% elseif return_reason.name == 'Faulty, please supply details' %}
                {% set reason_name = 'Arızalı, lütfen detay belirtin' %}
                {% elseif return_reason.name == 'Order Error' %}
                {% set reason_name = 'Sipariş hatası' %}
                {% elseif return_reason.name == 'Other, please supply details' %}
                {% set reason_name = 'Diğer, lütfen detay belirtin' %}
                {% elseif return_reason.name == 'Received Wrong Item' %}
                {% set reason_name = 'Yanlış ürün gönderildi' %}
                {% endif %}
                <label class="return-choice">
                  {% if return_reason.return_reason_id == return_reason_id %}
                  <input type="radio" name="return_reason_id" value="{{ return_reason.return_reason_id }}" checked="checked" />
                  {% else %}
                  <input type="radio" name="return_reason_id" value="{{ return_reason.return_reason_id }}" />
                  {% endif %}
                  <span>{{ reason_name }}</span>
                </label>
                {% endfor %}
              </div>
              {% if error_reason %}<div class="text-danger">{{ error_reason }}</div>{% endif %}
            </div>
            <div class="return-field required return-field--wide">
              <label>{{ entry_opened }}</label>
              <div class="return-inline-choice">
                <label class="return-choice return-choice--inline">
                  {% if opened %}
                  <input type="radio" name="opened" value="1" checked="checked" />
                  {% else %}
                  <input type="radio" name="opened" value="1" />
                  {% endif %}
                  <span>{{ text_yes }}</span>
                </label>
                <label class="return-choice return-choice--inline">
                  {% if not opened %}
                  <input type="radio" name="opened" value="0" checked="checked" />
                  {% else %}
                  <input type="radio" name="opened" value="0" />
                  {% endif %}
                  <span>{{ text_no }}</span>
                </label>
              </div>
            </div>
            <div class="return-field return-float return-field--wide">
              <textarea name="comment" rows="7" placeholder=" " id="input-comment" class="form-control">{{ comment }}</textarea>
              <label for="input-comment">{{ entry_fault_detail }}</label>
            </div>
            <div class="return-field return-field--wide">
              {{ captcha }}
            </div>
          </div>
        </section>

        <div class="return-actions">
          <a href="{{ back }}" class="btn btn-default return-back-btn"><i class="fa fa-angle-left"></i><span>{{ button_back }}</span></a>
          <div class="return-actions__submit">
            {% if text_agree %}
            <label class="return-agree">
              {% if agree %}
              <input type="checkbox" name="agree" value="1" checked="checked" />
              {% else %}
              <input type="checkbox" name="agree" value="1" />
              {% endif %}
              <span>{{ text_agree }}</span>
            </label>
            {% endif %}
            <button type="submit" class="btn btn-primary">{{ button_submit }}</button>
          </div>
        </div>
      </form>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
<script type="text/javascript"><!--
$('.date').datetimepicker({
	language: '{{ datepicker }}',
	pickTime: false
});
//--></script>
{{ footer }}
