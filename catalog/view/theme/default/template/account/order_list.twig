{{ header }}
<div id="account-order" class="container account-page">

  <style>
    /* ==========================================================================
       SIPARISLERIM / MY ORDERS TABLE REDESIGN
       ========================================================================== */
    #account-order #content {
      max-width: 1320px !important;
      width: 100% !important;
    }

    .account-orders-table-wrap {
      border: 1px solid rgba(26, 26, 80, 0.12);
      background: #ffffff;
      margin-bottom: 28px;
      overflow-x: visible;
      border-radius: 0;
      width: 100%;
    }

    @media (max-width: 991px) {
      .account-orders-table-wrap {
        overflow-x: auto;
      }
    }

    .account-orders-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 0;
      font-family: 'DM Sans', sans-serif;
      color: #1a1a50;
      background: transparent;
      table-layout: fixed;
    }

    .account-orders-table thead tr {
      background-color: #f5f2eb !important;
      border-bottom: 1px solid rgba(26, 26, 80, 0.12) !important;
    }

    .account-orders-table thead th,
    .account-orders-table thead td {
      width: 12.5% !important;
      padding: 14px 12px !important;
      font-family: 'DM Sans', sans-serif !important;
      font-size: 11px !important;
      font-weight: 500 !important;
      letter-spacing: 0.08em !important;
      text-transform: uppercase !important;
      color: #1a1a50 !important;
      background: transparent !important;
      border: none !important;
      border-right: 1px solid rgba(26, 26, 80, 0.08) !important;
      white-space: nowrap;
      vertical-align: middle !important;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .account-orders-table thead th:last-child,
    .account-orders-table thead td:last-child {
      border-right: none !important;
    }

    .account-orders-table tbody tr {
      border-bottom: 1px solid rgba(26, 26, 80, 0.08) !important;
      transition: background-color 0.2s ease;
    }

    .account-orders-table tbody tr:last-child {
      border-bottom: none !important;
    }

    .account-orders-table tbody tr:hover {
      background-color: transparent !important;
    }

    .account-orders-table tbody td {
      width: 12.5% !important;
      padding: 16px 12px !important;
      font-family: 'DM Sans', sans-serif !important;
      font-size: 13.5px !important;
      color: #1a1a50 !important;
      background: transparent !important;
      border: none !important;
      border-right: 1px solid rgba(26, 26, 80, 0.05) !important;
      vertical-align: middle !important;
      overflow: hidden;
      word-wrap: break-word;
    }

    .account-orders-table tbody td:last-child {
      border-right: none !important;
    }

    .account-order-id {
      font-weight: 500;
      color: #1a1a50;
    }

    .account-order-thumb {
      width: 60px;
      height: 60px;
      object-fit: cover;
      display: inline-block;
      vertical-align: middle;
      background: #f8f8f8;
      border: 1px solid rgba(26, 26, 80, 0.08);
      border-radius: 0;
    }

    /* Plain Text Status (No Box / No Orange Background) */
    .status-badge {
      display: inline-block;
      background: transparent !important;
      border: none !important;
      padding: 0 !important;
      font-family: 'DM Sans', sans-serif !important;
      font-size: 13.5px !important;
      font-weight: 400 !important;
      color: #1a1a50 !important;
      line-height: inherit;
    }

    /* İncele Link with center-expanding thin underline animation */
    .order-action-link {
      position: relative;
      display: inline-block;
      color: #1a1a50 !important;
      text-decoration: none !important;
      font-family: 'DM Sans', sans-serif;
      font-size: 13.5px;
      font-weight: 500;
      letter-spacing: 0.02em;
      text-transform: none;
      padding: 3px 2px;
      line-height: 1.4;
      transition: color 0.25s ease;
    }

    .order-action-link::after {
      content: '';
      position: absolute;
      bottom: 1px;
      left: 50%;
      width: 100%;
      height: 1px;
      background-color: #1a1a50;
      transform: translateX(-50%) scaleX(0);
      transform-origin: center;
      transition: transform 0.3s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .order-action-link:hover::after {
      transform: translateX(-50%) scaleX(1);
    }

    .order-action-link:hover,
    .order-action-link:focus {
      color: #1a1a50 !important;
      text-decoration: none !important;
    }
  </style>

  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
      {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
      {% set class = 'col-sm-9' %}
    {% else %}
      {% set class = 'col-sm-12' %}
    {% endif %}

    <div id="content" class="{{ class }}">{{ content_top }}
      <h1>{{ heading_title }}</h1>

      {% if orders %}
      <div class="table-responsive account-orders-table-wrap">
        <table class="table account-orders-table">
          <thead>
            <tr>
              <th class="text-left col-order-id">{{ column_order_id }}</th>
              <th class="text-center col-thumb">ÜRÜN</th>
              <th class="text-left col-customer">{{ column_customer }}</th>
              <th class="text-center col-products">{{ column_product }}</th>
              <th class="text-left col-status">{{ column_status }}</th>
              <th class="text-left col-total">{{ column_total }}</th>
              <th class="text-left col-date">{{ column_date_added }}</th>
              <th class="text-center col-action">DETAY</th>
            </tr>
          </thead>
          <tbody>
          {% for order in orders %}
            {% set status_tr = order.status %}
            {% set status_class = 'status-default' %}

            {% if order.status in ['Pending','Beklemede','On Hold','Bekliyor','Pending Payment','Pending Verification'] %}
              {% set status_tr = 'Beklemede' %}
              {% set status_class = 'status-pending' %}
            {% elseif order.status in ['Processing','Processed','Processing Payment','İşleniyor','Hazırlanıyor'] %}
              {% set status_tr = 'İşleniyor' %}
              {% set status_class = 'status-processing' %}
            {% elseif order.status in ['Shipped','Kargoda','Gönderildi','Kargoya Verildi'] %}
              {% set status_tr = 'Kargoya Verildi' %}
              {% set status_class = 'status-shipped' %}
            {% elseif order.status in ['Delivered','Teslim Edildi'] %}
              {% set status_tr = 'Teslim Edildi' %}
              {% set status_class = 'status-shipped' %}
            {% elseif order.status in ['Completed','Complete','Tamamlandı','Bitti'] %}
              {% set status_tr = 'Tamamlandı' %}
              {% set status_class = 'status-complete' %}
            {% elseif order.status in ['Canceled','Cancelled','İptal Edildi','İptal'] %}
              {% set status_tr = 'İptal Edildi' %}
              {% set status_class = 'status-canceled' %}
            {% elseif order.status in ['Refunded','İade Edildi','Returned'] %}
              {% set status_tr = 'İade Edildi' %}
              {% set status_class = 'status-refunded' %}
            {% elseif order.status in ['On Hold','Hold','Bekletiliyor'] %}
              {% set status_tr = 'Bekletiliyor' %}
              {% set status_class = 'status-hold' %}
            {% endif %}

            <tr>
              <td class="text-left col-order-id account-order-id">#{{ order.order_id }}</td>

              <td class="text-center col-thumb">
                {% if order.thumb %}
                  <img src="{{ order.thumb }}" alt="{{ order.name }}" class="account-order-thumb">
                {% endif %}
              </td>

              <td class="text-left col-customer">{{ order.name }}</td>
              <td class="text-center col-products">{{ order.products }}</td>

              <td class="text-left col-status">
                <span class="status-badge {{ status_class }}">{{ status_tr }}</span>
              </td>

              <td class="text-left col-total">{{ order.total }}</td>
              <td class="text-left col-date">{{ order.date_added }}</td>
              <td class="text-center col-action">
                <a href="{{ order.view }}" class="order-action-link" title="{{ button_view }}">
                  İncele
                </a>
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="row" style="margin-top: 15px;">
        <div class="col-sm-12 text-center">{{ pagination }}</div>
      </div>

      {% else %}
        <p>{{ text_empty }}</p>
      {% endif %}

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>
{{ footer }}
