	label {
		font-size: 15px;
		font-weight: normal;
	}
	.list-group {
		padding-top: 30px;
	}
	.category-list-toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}
	.category-list-toolbar__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		gap: 0.65rem;
		margin-left: auto;
	}
	.category-tool-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.65rem 1.15rem;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.2;
		color: #fff;
		background: #1a1a50;
		border: 1px solid transparent;
		border-radius: 10px;
		box-shadow: 0 2px 8px rgba(26, 26, 80, 0.18);
		transition: background 0.2s ease, box-shadow 0.2s ease, transform 0.15s ease;
	}
	.category-tool-btn:hover,
	.category-tool-btn:focus {
		color: #fff;
		background: #22226a;
		box-shadow: 0 4px 14px rgba(26, 26, 80, 0.28);
		outline: none;
	}
	.category-tool-btn:active {
		transform: scale(0.98);
	}
	.category-view-toggle {
		display: inline-flex;
		align-items: stretch;
		padding: 3px;
		background: #f0f1f8;
		border: 1px solid #e2e4ef;
		border-radius: 10px;
		gap: 2px;
	}
	.category-view-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 2.5rem;
		height: 2.35rem;
		padding: 0 0.65rem;
		font-size: 1rem;
		color: #1a1a50;
		background: transparent;
		border: none;
		border-radius: 7px;
		transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
	}
	.category-view-btn:hover,
	.category-view-btn:focus {
		color: #1a1a50;
		background: rgba(26, 26, 80, 0.08);
		outline: none;
	}
	.category-view-btn.active {
		color: #fff;
		background: #1a1a50;
		box-shadow: 0 2px 6px rgba(26, 26, 80, 0.25);
	}
