<div id="product-category" class="container">


	<div class="row">{{ column_left }}
		{% if column_left and column_right %}
			{% set class = 'col-sm-6' %}
		{% elseif column_left or column_right %}
			{% set class = 'col-sm-9' %}
		{% else %}
			{% set class = 'col-sm-12' %}
		{% endif %}

		<div id="content" class="{{ class }}">{{ content_top }}

			{% if is_collection_hub %}
			<div class="collection-hub">
				<header class="collection-hub__header">
					{% if collection_parent_name %}
					<p class="collection-hub__eyebrow">{{ collection_parent_name }}</p>
					{% endif %}
					<h1 class="collection-hub__title">{{ heading_title }}</h1>
				</header>
				<div class="collection-grid">
					{% for category in categories %}
					<a href="{{ category.href }}" class="collection-grid__card">
						<span class="collection-grid__media">
							<img src="{{ category.thumb }}" alt="{{ category.name }}" class="collection-grid__img" />
						</span>
						<span class="collection-grid__name">{{ category.name }}</span>
					</a>
					{% endfor %}
				</div>
			</div>
			<div class="giyim-filter-bar">
				<div class="giyim-breadcrumb">
					<span>Tüm Ürünler</span> &middot; <span>{{ heading_title }}</span>
				</div>
				<div class="giyim-filter-link">Filtrele +</div>
			</div>

			{% if products %}
				<div class="uannes-row-grid">
					{% for product in products %}
					<a href="{{ product.href }}" class="uannes-row-card">
						<div class="uannes-row-media">
							{% include 'common/product_badges.twig' with { badges: product.badges|default([]) } only %}
							<img src="{{ product.thumb }}" class="uannes-row-img main-img" alt="{{ product.name }}" title="{{ product.name }}"/>
							{% if product.thumb2 %}
								<img src="{{ product.thumb2 }}" class="uannes-row-img hover-img" alt="{{ product.name }} Hover"/>
							{% endif %}
						</div>
						<div class="uannes-row-info">
							<span class="uannes-row-name">{{ product.name }}</span>
							{% if product.price %}
								<div class="uannes-row-price-box">
									<span class="uannes-row-currency">TRY</span>
									<span class="uannes-row-price">{{ product.price }}</span>
								</div>
							{% endif %}
						</div>
					</a>
					{% endfor %}
				</div>

				<div class="row" style="margin-top: 40px;">
					<div class="col-sm-6 text-left">{{ pagination }}</div>
				</div>
			{% endif %}

			{% if not products %}
				<p>{{ text_empty }}</p>
				<div class="buttons">
					<div class="pull-right">
						<a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a>
					</div>
				</div>
			{% endif %}
			{% endif %}

			{{ content_bottom }}
		</div>
		{{ column_right }}</div>
</div>

{# Filtre paneli — geçici kapalı
<div id="filterSidebar">
	<button type="button" class="close" id="closeFilter">&times;</button>
	{{ filter }}
</div>
<div id="filterOverlay"></div>
#}

{{ footer }}

<script type="text/javascript">
$(document).ready(function(){
  {# Filtre paneli JS — geçici kapalı
  $('#openFilter').click(function(){
    $('#filterSidebar, #filterOverlay').addClass('show');
    $('body').css('overflow','hidden');
  });
  $('#closeFilter, #filterOverlay').click(function(){
    $('#filterSidebar, #filterOverlay').removeClass('show');
    $('body').css('overflow','auto');
  });
  #}

  $('#grid-view-4').click(function() {
    $('#product-list .product-layout').attr('class', 'product-layout col-lg-3 col-md-4 col-sm-6 col-xs-6');
    $('#grid-view-4').addClass('active');
    $('#grid-view-6').removeClass('active');
    localStorage.setItem('display', 'grid-4');
  });

  $('#grid-view-6').click(function() {
    $('#product-list .product-layout').attr('class', 'product-layout col-lg-2 col-md-3 col-sm-4 col-xs-6');
    $('#grid-view-6').addClass('active');
    $('#grid-view-4').removeClass('active');
    localStorage.setItem('display', 'grid-6');
  });

  var display = localStorage.getItem('display');
  if (display == 'grid-6') {
    $('#grid-view-6').trigger('click');
  } else {
    $('#grid-view-4').addClass('active');
  }
});

$(document).on('mouseleave', '.giyim-product-media', function() {
  var $media = $(this);
  $media.removeClass('show-2');
  $media.find('.giyim-swatch').removeClass('active').eq(0).addClass('active');
});

function toggleGiyimProductImg(el, target) {
  var $media = $(el).closest('.giyim-product-media');
  var $swatches = $media.find('.giyim-swatch');
  
  var isShowingSecond = $media.hasClass('show-2');

  if (target === 'next' || target === 'prev') {
    if (isShowingSecond) {
      $media.removeClass('show-2');
      $swatches.removeClass('active').eq(0).addClass('active');
    } else {
      $media.addClass('show-2');
      $swatches.removeClass('active').eq(1).addClass('active');
    }
  } else if (target === 0) {
    $media.removeClass('show-2');
    $swatches.removeClass('active').eq(0).addClass('active');
  } else if (target === 1) {
    $media.addClass('show-2');
    $swatches.removeClass('active').eq(1).addClass('active');
  }
}
</script>
