{{ header }}
<style>
/* İletişim Sayfası Özel Tasarımı */
footer { margin-top: 0; }

#content {
  min-height: 0 !important;
}

#information-contact {
  margin-top: 15px;
  margin-bottom: 60px;
}

#information-contact,
#information-contact p,
#information-contact .contact-details {
  font-family: 'DM Sans', sans-serif;
  font-size: 13.5px;
  font-weight: 400;
  color: #1a1a50;
}

/* Form heading */
#information-contact .contact-heading-main {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 400;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #1a1a50;
  font-size: 22px;
  text-align: center;
  margin-bottom: 35px;
}

/* Contact Info text */
#information-contact .contact-details p {
  margin-bottom: 15px;
  line-height: 1.8;
}
#information-contact .contact-details a {
  color: #1a1a50;
  text-decoration: none;
}
#information-contact .contact-details a:not(.btn-white):hover {
  text-decoration: underline;
}

/* Floating label input styling fix for contact page */
#information-contact .login-field {
  position: relative;
  margin-top: 16px;
  margin-bottom: 28px;
}

#information-contact .login-field__input {
  display: block !important;
  width: 100% !important;
  height: 48px !important;
  border: none !important;
  border-bottom: 1px solid rgba(26, 26, 80, 0.25) !important;
  border-radius: 0 !important;
  background: transparent !important;
  padding: 14px 10px 6px 10px !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size: 14.5px !important;
  font-weight: 400 !important;
  color: #1a1a50 !important;
  outline: none !important;
  box-shadow: none !important;
  box-sizing: border-box !important;
  line-height: 1.4 !important;
}

#information-contact textarea.login-field__input {
  height: auto !important;
  min-height: 120px !important;
  resize: vertical !important;
  padding: 12px 10px 10px 10px !important;
}

#information-contact .login-field__label {
  position: absolute !important;
  left: 10px !important;
  top: 24px !important;
  transform: translateY(-50%) !important;
  font-family: 'DM Sans', sans-serif !important;
  font-size: 14px !important;
  color: rgba(26, 26, 80, 0.6) !important;
  pointer-events: none !important;
  transition: all 0.2s ease !important;
}

#information-contact textarea.login-field__input + .login-field__label {
  top: 20px !important;
  transform: translateY(0) !important;
}

#information-contact .login-field__input:focus + .login-field__label,
#information-contact .login-field__input:not(:placeholder-shown) + .login-field__label {
  top: -16px !important;
  transform: translateY(0) !important;
  font-size: 11px !important;
  color: rgba(26, 26, 80, 0.8) !important;
  font-weight: 600 !important;
  letter-spacing: 0.05em !important;
}

/* Flexbox Layout for perfect centering */
#information-contact .contact-wrapper {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: flex-start;
  gap: 50px;
  max-width: 900px;
  margin: 0 auto;
}

#information-contact .contact-form-side,
#information-contact .contact-info-side {
  flex: 1;
  min-width: 320px;
  max-width: 400px;
}

/* Mavi Buton (Gönder) */
#information-contact .btn-blue {
  display: block;
  width: 100%;
  padding: 14px 24px;
  background-color: #1a1a50;
  color: #fff !important;
  border: 1.5px solid #1a1a50;
  font-family: 'DM Sans', sans-serif;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  cursor: pointer;
  transition: all 0.35s ease;
  border-radius: 0;
  text-align: center;
}
#information-contact .btn-blue:hover {
  background-color: #fff;
  color: #1a1a50 !important;
}

/* Beyaz Buton (Haritayı Göster) */
#information-contact .btn-white {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 13px 0; /* Remove side padding to align exactly with text */
  background: transparent;
  color: #1a1a50 !important;
  border: none;
  font-family: 'DM Sans', sans-serif;
  font-size: 12.5px;
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  text-decoration: none !important;
  cursor: pointer;
  transition: color 0.35s ease;
  border-radius: 0;
}
#information-contact .btn-white span {
  position: relative;
  padding-bottom: 4px;
  background-image: linear-gradient(#1a1a50, #1a1a50);
  background-size: 0% 1px;
  background-repeat: no-repeat;
  background-position: center bottom;
  transition: background-size 0.3s ease;
}

#information-contact .btn-white:hover span {
  background-size: 100% 1px;
}

#information-contact .btn-white:hover {
  text-decoration: none !important;
}
</style>
<div id="information-contact" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      
      <div class="row mt-5">
        <div class="col-12">
          <h2 class="contact-heading-main">{{ heading_title }}</h2>
        </div>
      </div>
      
      <div class="contact-wrapper mt-3">
        
        <div class="contact-form-side">
          <form action="{{ action }}" method="post" enctype="multipart/form-data">
            
            {% if error_warning %}
            <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}</div>
            {% endif %}

            <div class="login-field">
              <input type="text" name="name" value="{{ name }}" id="input-name" class="login-field__input" placeholder=" " required />
              <label for="input-name" class="login-field__label">{{ entry_name }} *</label>
              <span class="login-field__line"></span>
              {% if error_name %}<div class="text-danger mt-1">{{ error_name }}</div>{% endif %}
            </div>
            
            <div class="login-field">
              <input type="email" name="email" value="{{ email }}" id="input-email" class="login-field__input" placeholder=" " required />
              <label for="input-email" class="login-field__label">{{ entry_email }} *</label>
              <span class="login-field__line"></span>
              {% if error_email %}<div class="text-danger mt-1">{{ error_email }}</div>{% endif %}
            </div>
            
            <div class="login-field">
              <textarea name="enquiry" rows="5" id="input-enquiry" class="login-field__input" placeholder=" " required>{{ enquiry }}</textarea>
              <label for="input-enquiry" class="login-field__label">{{ entry_enquiry }} *</label>
              <span class="login-field__line"></span>
              {% if error_enquiry %}<div class="text-danger mt-1">{{ error_enquiry }}</div>{% endif %}
            </div>
            
            {{ captcha }}
            
            <div class="mt-4">
              <button type="submit" class="btn-blue">
                <span>{{ button_submit }}</span>
              </button>
            </div>
          </form>
        </div>
        
        <div class="contact-info-side pt-2">
          <div class="contact-details">
            {% if address %}
            <p><strong>Adres:</strong><br/> {{ address }}</p>
            {% endif %}
            {% if telephone %}
            <p><strong>{{ text_telephone }}</strong> {{ telephone }}</p>
            {% endif %}
            {% if store_email %}
            <p><strong>E-Posta:</strong> <a href="mailto:{{ store_email }}">{{ store_email }}</a></p>
            {% endif %}
            {% if open %}
            <p><strong>{{ text_open }}:</strong><br />{{ open }}</p>
            {% endif %}
            {% if geocode %}
            <div class="mt-3">
              <a href="http://maps.google.com/maps?q={{ geocode|url_encode }}&hl={{ geocode_hl }}&t=m&z=15" target="_blank" class="btn-white">
                <span><i class="fa fa-map-marker"></i> {{ button_map }}</span>
              </a>
            </div>
            {% endif %}
          </div>
        </div>
        
      </div>
      {# OpenCart'ın çoklu mağaza/konum listeleme kısmı (İsteğe bağlı olarak korundu) #}
      {% if locations %}
      <h3>{{ text_store }}</h3>
      <div class="panel-group" id="accordion">
        {% for location in locations %}
        <div class="panel panel-default">
          <div class="panel-heading">
            <h4 class="panel-title"><a href="#collapse-location{{ location.location_id }}" class="accordion-toggle" data-toggle="collapse" data-parent="#accordion">{{ location.name }} <i class="fa fa-caret-down"></i></a></h4>
          </div>
          <div class="panel-collapse collapse" id="collapse-location{{ location.location_id }}">
            <div class="panel-body">
              <div class="row">
                {% if location.image %}
                <div class="col-sm-3"><img src="{{ location.image }}" alt="{{ location.name }}" title="{{ location.name }}" class="img-thumbnail" /></div>
                {% endif %}
                <div class="col-sm-3"><strong>{{ location.name }}</strong><br/>
                  <address>
                  {{ location.address }}
                  </address>
                  {% if location.geocode %}
                  <a href="http://maps.google.com/maps?q={{ location.geocode|url_encode }}&hl={{ geocode_hl }}&t=m&z=15" target="_blank" class="btn btn-info"><i class="fa fa-map-marker"></i> {{ button_map }}</a>
                  {% endif %}
                </div>
                <div class="col-sm-3"> <strong>{{ text_telephone }}</strong><br/>
                  {{ location.telephone }}<br/>
                  <br/>
                  {% if location.fax %}
                  <strong>{{ text_fax }}</strong><br/>
                  {{ location.fax }}
                  {% endif %}
                </div>
                <div class="col-sm-3">
                  {% if location.open %}
                  <strong>{{ text_open }}</strong><br/>
                  {{ location.open }}<br/>
                  <br/>
                  {% endif %}
                  {% if location.comment %}
                  <strong>{{ text_comment }}</strong><br/>
                  {{ location.comment }}
                  {% endif %}
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      {% endif %}
      {# OpenCart'ın varsayılan form yapısı (Kaldırıldı veya yukarı taşındı) #}
      {# 
      <form action="{{ action }}" method="post" enctype="multipart/form-data" class="form-horizontal">
        ... (form içeriği)
      </form>
      #}
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}