{{ header }}
<style>
/* FAQ Sayfası Özel Tasarımı (Uannes Luxury Standartları) */
footer { margin-top: 0; }

#content {
  min-height: 0 !important;
}

#information-faq {
  margin-top: 30px;
  margin-bottom: 70px;
}

#information-faq,
#information-faq p {
  font-family: 'DM Sans', sans-serif;
  font-size: 13.5px;
  font-weight: 400;
  color: #1a1a50;
}

/* Remove default white boxes */
#information-faq .faq-container {
  background: transparent !important;
  box-shadow: none !important;
  padding: 0 !important;
  border: none !important;
}

/* FAQ heading */
#information-faq .faq-title-container h1 {
  font-family: 'Cormorant Garamond', Georgia, serif;
  font-weight: 400;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #1a1a50 !important;
  font-size: 26px !important;
  text-align: center;
  margin-bottom: 45px;
  margin-top: 0;
}

#information-faq .faq-content-container {
  max-width: 720px;
  margin: 0 auto;
}

#information-faq .faq-item {
  border-bottom: 1px solid rgba(26, 26, 80, 0.15) !important;
  padding: 22px 0 !important;
  transition: all 0.2s ease;
}

#information-faq .faq-item:first-child {
  border-top: 1px solid rgba(26, 26, 80, 0.15) !important;
}

#information-faq .faq-question {
  display: flex;
  justify-content: space-between;
  align-items: center;
  cursor: pointer;
  user-select: none;
  gap: 16px;
}

#information-faq .faq-question h2 {
  font-family: 'DM Sans', sans-serif !important;
  font-weight: 500 !important;
  font-size: 14px !important;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #1a1a50 !important;
  margin: 0 !important;
  line-height: 1.4;
  transition: color 0.2s ease;
}

#information-faq .faq-question:hover h2 {
  color: #c5a059 !important;
}

#information-faq .toggle-btn {
  background: none;
  border: none;
  color: #1a1a50;
  cursor: pointer;
  transition: transform 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

#information-faq .faq-question.active .toggle-btn,
#information-faq .faq-question[aria-expanded="true"] .toggle-btn,
#information-faq .toggle-btn.rotate {
  transform: rotate(90deg);
}

#information-faq .faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.4s cubic-bezier(0.25, 0.8, 0.25, 1);
}

#information-faq .faq-answer-inner {
  font-family: 'DM Sans', sans-serif;
  font-size: 13.5px;
  font-weight: 400;
  color: rgba(26, 26, 80, 0.85) !important;
  line-height: 1.85;
  padding-top: 16px;
  padding-bottom: 6px;
}
</style>

<div id="information-faq" class="container">
  <div class="row">{{ column_left }}
    {% if column_left and column_right %}
    {% set class = 'col-sm-6' %}
    {% elseif column_left or column_right %}
    {% set class = 'col-sm-9' %}
    {% else %}
    {% set class = 'col-sm-12' %}
    {% endif %}
    <div id="content" class="{{ class }}">{{ content_top }}
      <div class="faq-main-container">
        <div class="faq-container faq-title-container">
          <h1>{{ heading_title }}</h1>
        </div>
        <div class="faq-container faq-content-container">
          {% if faqs %}
            {% for faq in faqs %}
            <div class="faq-item" data-faq-id="{{ faq.faq_id }}">
              <div class="faq-question" role="button" tabindex="0" aria-expanded="false">
                <h2>{{ faq.question }}</h2>
                <button type="button" class="toggle-btn" aria-label="Cevabı Göster/Gizle">
                  <svg width="7" height="12" viewBox="0 0 6 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L5 5.5L1 10" stroke="#1a1a50" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              <div class="faq-answer">
                <div class="faq-answer-inner">{{ faq.answer|raw|nl2br }}</div>
              </div>
            </div>
            {% endfor %}
          {% else %}
            <div class="faq-item" data-faq-id="fallback-1">
              <div class="faq-question" role="button" tabindex="0" aria-expanded="false">
                <h2>SİPARİŞİM NE ZAMAN KARGOYA VERİLİR?</h2>
                <button type="button" class="toggle-btn" aria-label="Cevabı Göster/Gizle">
                  <svg width="7" height="12" viewBox="0 0 6 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L5 5.5L1 10" stroke="#1a1a50" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              <div class="faq-answer">
                <div class="faq-answer-inner">Siparişleriniz genellikle 1-3 iş günü içerisinde özenle hazırlanıp kargoya teslim edilmektedir. Kampanya dönemlerinde bu süre 5 iş gününe kadar uzayabilmektedir.</div>
              </div>
            </div>
            
            <div class="faq-item" data-faq-id="fallback-2">
              <div class="faq-question" role="button" tabindex="0" aria-expanded="false">
                <h2>KARGO ÜCRETİ NE KADAR?</h2>
                <button type="button" class="toggle-btn" aria-label="Cevabı Göster/Gizle">
                  <svg width="7" height="12" viewBox="0 0 6 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L5 5.5L1 10" stroke="#1a1a50" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              <div class="faq-answer">
                <div class="faq-answer-inner">Standart kargo ücretimiz 49 TL'dir. 500 TL ve üzeri siparişlerinizde kargo ücretsizdir.</div>
              </div>
            </div>
            
            <div class="faq-item" data-faq-id="fallback-3">
              <div class="faq-question" role="button" tabindex="0" aria-expanded="false">
                <h2>İADE VE DEĞİŞİM POLİTİKANIZ NEDİR?</h2>
                <button type="button" class="toggle-btn" aria-label="Cevabı Göster/Gizle">
                  <svg width="7" height="12" viewBox="0 0 6 11" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L5 5.5L1 10" stroke="#1a1a50" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
              <div class="faq-answer">
                <div class="faq-answer-inner">Kullanılmamış ve ambalajı zarar görmemiş ürünleri teslim aldığınız tarihten itibaren 14 gün içerisinde iade edebilir veya değiştirebilirsiniz.</div>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
      {{ content_bottom }}</div>
    {{ column_right }}</div>
</div>
{{ footer }}
