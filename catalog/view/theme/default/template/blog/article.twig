{{ header }}
<div id="blog-article" class="blog-page">
  <div class="container blog-article-wrap">
    <ul class="breadcrumb blog-page-breadcrumb blog-article-breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
      {% endfor %}
    </ul>

    <article class="blog-article">
      <header class="blog-article-header">
        {% if category_name %}
          <a href="{{ category_href }}" class="blog-article-category">{{ category_name }}</a>
        {% endif %}
        <h1 class="blog-article-title">{{ heading_title }}</h1>
        <p class="blog-article-meta">
          <time datetime="{{ date_published }}">{{ text_date }}: {{ date_published }}</time>
        </p>
      </header>
    </article>

    {% if image %}
      <figure class="blog-article-cover">
        <img src="{{ image }}" alt="{{ heading_title }}" class="blog-article-cover__img" />
      </figure>
    {% endif %}

    <div class="blog-article-body">
      {{ description|raw }}
    </div>

    {{ content_top }}{{ content_bottom }}
  </div>
</div>
{{ footer }}
