<style>
.home-banner-stack__item--slideshow .home-banner-stack__overlay {
  right: max(8%, calc((100vw - 1320px) / 2 + 15px));
  left: auto;
  width: 44%;
  max-width: 540px;
  align-items: flex-end;
  text-align: right;
}
.home-banner-stack__item--slideshow .home-banner-stack__title,
.home-banner-stack__item--slideshow .home-banner-stack__desc {
  text-align: right;
  max-width: 36rem;
}
.home-banner-stack__item--slideshow .home-banner-stack__btn {
  align-self: flex-end;
}
@media (max-width: 767px) {
  .home-banner-stack__item--slideshow .home-banner-stack__overlay {
    width: 85%;
    max-width: 100%;
    right: 7.5%;
    left: auto;
  }
}
</style>
<div class="home-banner-stack">
  {% for banner in banners %}
    {% if loop.index < 3 %}
    <div class="home-banner-stack__item home-banner-stack__item--slideshow">
      <div class="home-banner-stack__media">
        <img src="{% if loop.first %}image/catalog/marka_hikayesi_card1.png{% else %}{{ banner.image }}{% endif %}" alt="{{ banner.title }}" class="img-responsive home-banner-stack__img">
        {% if banner.title or banner.description or (banner.button_text and banner.link) %}
          <div class="home-banner-stack__overlay">
            {% if banner.title %}
              <h2 class="home-banner-stack__title">{{ banner.title }}</h2>
            {% endif %}
            {% if banner.description %}
              <p class="home-banner-stack__desc">{{ banner.description }}</p>
            {% endif %}
            {% if banner.button_text and banner.link %}
              <a href="{{ banner.link }}" class="home-banner-stack__btn"><span class="home-banner-stack__btn-label">{{ banner.button_text }}</span></a>
            {% endif %}
          </div>
        {% endif %}
      </div>
    </div>
    {% endif %}
  {% endfor %}
</div>
