<div class="container py-5">
  <div class="d-flex justify-content-between align-items-center mb-4 section-header" style="padding-bottom:30px;">
    <h3 class="fw-normal m-0">{{ heading_title }}</h3>
    {# <a href="{{ view_all_link }}" class="show-all-link text-decoration-none fw-normal">TÜMÜNÜ GÖR</a> #}
  </div>

  <div class="row g-3">
    {% for product in products %}
      <div class="col-6 col-md-3">
        <div class="product-card text-center{% if product.in_stock is defined and not product.in_stock %} product-card--out-of-stock{% endif %}">
          <div class="product-image-container position-relative">
            {% include 'common/product_badges.twig' with { badges: product.badges } only %}
            <a href="{{ product.href }}">
              <img src="{{ product.thumb }}" class="product-image img-fluid mb-3 main-img" alt="{{ product.name }}" title="{{ product.name }}"/>
              {% if product.thumb2 %}
                <img src="{{ product.thumb2 }}" class="product-image img-fluid hover-img" alt="{{ product.name }} Hover"/>
              {% else %}
                <img src="{{ product.thumb }}" class="product-image img-fluid hover-img" alt="{{ product.name }} Hover"/>
              {% endif %}
            </a>
          </div>
          <h6 class="fw-normal" style="font-size:18px;">{{ product.name }}</h6>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<style>

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

</style>
