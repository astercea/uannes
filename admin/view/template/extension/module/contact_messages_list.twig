{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-contact-message" formaction="{{ mark_read }}" data-toggle="tooltip" title="{{ button_mark_read }}" class="btn btn-default"><i class="fa fa-envelope-open-o"></i> {{ button_mark_read }}</button>
        <button type="button" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-contact-message').submit() : false;"><i class="fa fa-trash-o"></i> {{ button_delete }}</button>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-list"></i> {{ text_list }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ delete }}" method="post" enctype="multipart/form-data" id="form-contact-message">
          <div class="table-responsive">
            <table class="table table-bordered table-hover">
              <thead>
                <tr>
                  <td style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);" /></td>
                  <td class="text-left" style="width: 110px;">{{ column_status }}</td>
                  <td class="text-left" style="width: 180px;">{{ column_name }}</td>
                  <td class="text-left" style="width: 220px;">{{ column_email }}</td>
                  <td class="text-left">{{ column_enquiry }}</td>
                  <td class="text-left" style="width: 160px;">{{ column_date_added }}</td>
                  <td class="text-right" style="width: 170px;">{{ column_action }}</td>
                </tr>
              </thead>
              <tbody>
                {% if messages %}
                {% for message in messages %}
                <tr id="message-row-{{ message.contact_message_id }}" style="cursor: pointer; {% if not message.status %}font-weight: 600; background-color: rgba(205, 160, 89, 0.08);{% endif %}">
                  <td class="text-center" onclick="event.stopPropagation();">
                    {% if message.contact_message_id in selected %}
                    <input type="checkbox" name="selected[]" value="{{ message.contact_message_id }}" checked="checked" />
                    {% else %}
                    <input type="checkbox" name="selected[]" value="{{ message.contact_message_id }}" />
                    {% endif %}
                  </td>
                  <td class="text-left" onclick="viewMessageModal({{ message.contact_message_id }});">
                    {% if message.status %}
                      <span class="label label-default" id="status-badge-{{ message.contact_message_id }}" style="background-color: #e5e5e5; color: #555; font-weight: normal; padding: 4px 8px; border-radius: 4px;">{{ text_read }}</span>
                    {% else %}
                      <span class="label label-warning" id="status-badge-{{ message.contact_message_id }}" style="background-color: #c5a059; color: #fff; font-weight: 600; padding: 4px 8px; border-radius: 4px;">{{ text_unread }}</span>
                    {% endif %}
                  </td>
                  <td class="text-left" onclick="viewMessageModal({{ message.contact_message_id }});">
                    <strong style="color: #1a1a50;">{{ message.name }}</strong>
                  </td>
                  <td class="text-left" onclick="event.stopPropagation();">
                    <a href="mailto:{{ message.email }}" style="color: #1a1a50; text-decoration: underline;">{{ message.email }}</a>
                  </td>
                  <td class="text-left" onclick="viewMessageModal({{ message.contact_message_id }});">
                    <span style="color: #444;">{{ message.enquiry }}</span>
                  </td>
                  <td class="text-left" onclick="viewMessageModal({{ message.contact_message_id }});" style="font-size: 12px; color: #777;">
                    {{ message.date_added }}
                  </td>
                  <td class="text-right" onclick="event.stopPropagation();">
                    <button type="button" onclick="viewMessageModal({{ message.contact_message_id }});" data-toggle="tooltip" title="Hızlı Oku" class="btn btn-default btn-sm"><i class="fa fa-search"></i> İncele</button>
                    <a href="{{ message.view }}" data-toggle="tooltip" title="{{ button_view }}" class="btn btn-primary btn-sm"><i class="fa fa-eye"></i> Detay</a>
                  </td>
                </tr>
                {% endfor %}
                {% else %}
                <tr>
                  <td class="text-center" colspan="7">{{ text_no_results }}</td>
                </tr>
                {% endif %}
              </tbody>
            </table>
          </div>
        </form>
        <div class="row">
          <div class="col-sm-6 text-left">{{ pagination }}</div>
          <div class="col-sm-6 text-right">{{ results }}</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal Quick View -->
<div class="modal fade" id="modal-message-view" tabindex="-1" role="dialog">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content" style="border-radius: 12px; border: 1px solid var(--uannes-border, #e5dfd5); box-shadow: 0 10px 40px rgba(0,0,0,0.12);">
      <div class="modal-header" style="background-color: #f8f6f2; border-bottom: 1px solid #eeeae0; border-top-left-radius: 12px; border-top-right-radius: 12px; padding: 18px 24px;">
        <button type="button" class="close" data-dismiss="modal" aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
        <h4 class="modal-title" id="modal-msg-title" style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 24px; font-weight: 600; color: #1a1a50; letter-spacing: 0.05em; text-transform: uppercase;">
          <i class="fa fa-envelope-o"></i> Mesaj Ayrıntısı
        </h4>
      </div>
      <div class="modal-body" style="padding: 24px; background-color: #fff;">
        <div class="row" style="margin-bottom: 16px;">
          <div class="col-sm-6">
            <label style="color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 2px;">Gönderen</label>
            <div id="modal-msg-name" style="font-size: 16px; font-weight: 700; color: #1a1a50;">-</div>
          </div>
          <div class="col-sm-6">
            <label style="color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 2px;">E-Posta</label>
            <div><a id="modal-msg-email" href="#" style="font-size: 15px; color: #1a1a50; font-weight: 600; text-decoration: underline;">-</a></div>
          </div>
        </div>
        <div class="row" style="margin-bottom: 20px; border-bottom: 1px solid #f0ebe1; padding-bottom: 14px;">
          <div class="col-sm-6">
            <label style="color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 2px;">Tarih</label>
            <div id="modal-msg-date" style="font-size: 13px; color: #555;">-</div>
          </div>
          <div class="col-sm-6">
            <label style="color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 2px;">IP Adresi</label>
            <div id="modal-msg-ip" style="font-size: 13px; color: #777;">-</div>
          </div>
        </div>
        <div>
          <label style="color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; display: block; margin-bottom: 8px;">Mesaj İçeriği</label>
          <div id="modal-msg-enquiry" style="background-color: #fbf9f4; border: 1px solid #eeeae0; border-radius: 8px; padding: 20px; font-size: 14.5px; line-height: 1.7; color: #1a1a50; white-space: pre-wrap; word-break: break-word; min-height: 120px;">
            Yükleniyor...
          </div>
        </div>
      </div>
      <div class="modal-footer" style="background-color: #f8f6f2; border-top: 1px solid #eeeae0; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; padding: 16px 24px;">
        <a id="modal-msg-reply" href="#" class="btn btn-primary"><i class="fa fa-reply"></i> E-Posta ile Yanıtla</a>
        <a id="modal-msg-fullpage" href="#" class="btn btn-default"><i class="fa fa-external-link"></i> Tam Sayfada Aç</a>
        <a id="modal-msg-delete" href="#" onclick="return confirm('Bu mesajı silmek istediğinizden emin misiniz?');" class="btn btn-danger"><i class="fa fa-trash-o"></i> Sil</a>
        <button type="button" class="btn btn-default" data-dismiss="modal">Kapat</button>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript">
function viewMessageModal(message_id) {
  $('#modal-msg-enquiry').html('<i class="fa fa-spinner fa-spin"></i> Yükleniyor...');
  $('#modal-message-view').modal('show');

  $.ajax({
    url: 'index.php?route=extension/module/contact_messages/getJson&user_token={{ user_token }}&contact_message_id=' + message_id,
    type: 'GET',
    dataType: 'json',
    success: function(json) {
      if (json && json.success) {
        $('#modal-msg-name').text(json.name);
        $('#modal-msg-email').text(json.email).attr('href', 'mailto:' + json.email + '?subject=UANNES - İletişim Mesajınız Hakkında');
        $('#modal-msg-date').text(json.date_added);
        $('#modal-msg-ip').text(json.ip);
        $('#modal-msg-enquiry').html(json.enquiry);
        $('#modal-msg-reply').attr('href', 'mailto:' + json.email + '?subject=UANNES - İletişim Mesajınız Hakkında');
        $('#modal-msg-fullpage').attr('href', 'index.php?route=extension/module/contact_messages/view&user_token={{ user_token }}&contact_message_id=' + message_id);
        $('#modal-msg-delete').attr('href', json.delete_url);

        // Update row styling
        $('#message-row-' + message_id).css({'font-weight': 'normal', 'background-color': 'transparent'});
        $('#status-badge-' + message_id).removeClass('label-warning').addClass('label-default').css({'background-color': '#e5e5e5', 'color': '#555', 'font-weight': 'normal'}).text('{{ text_read }}');
      }
    }
  });
}
</script>

{{ footer }}
