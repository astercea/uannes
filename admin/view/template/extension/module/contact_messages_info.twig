{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="mailto:{{ message.email }}?subject=UANNES - İletişim Mesajınız Hakkında" class="btn btn-primary"><i class="fa fa-reply"></i> {{ button_reply }}</a>
        <a href="{{ delete }}" onclick="return confirm('{{ text_confirm }}');" data-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger"><i class="fa fa-trash-o"></i> {{ button_delete }}</a>
        <a href="{{ back }}" data-toggle="tooltip" title="Geri Dön" class="btn btn-default"><i class="fa fa-reply"></i> Geri Dön</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-envelope"></i> {{ text_view }}</h3>
      </div>
      <div class="panel-body" style="padding: 28px;">
        <div class="row" style="margin-bottom: 24px;">
          <div class="col-md-3 col-sm-6" style="margin-bottom: 15px;">
            <div style="background: #f8f6f2; border: 1px solid #eeeae0; border-radius: 8px; padding: 16px;">
              <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 4px;">Gönderen</div>
              <div style="font-size: 16px; font-weight: 700; color: #1a1a50;"><i class="fa fa-user-circle-o"></i> {{ message.name }}</div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6" style="margin-bottom: 15px;">
            <div style="background: #f8f6f2; border: 1px solid #eeeae0; border-radius: 8px; padding: 16px;">
              <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 4px;">E-Posta</div>
              <div><a href="mailto:{{ message.email }}?subject=UANNES - İletişim Mesajınız Hakkında" style="font-size: 14.5px; font-weight: 600; color: #1a1a50; text-decoration: underline;"><i class="fa fa-envelope"></i> {{ message.email }}</a></div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6" style="margin-bottom: 15px;">
            <div style="background: #f8f6f2; border: 1px solid #eeeae0; border-radius: 8px; padding: 16px;">
              <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 4px;">Gönderim Tarihi</div>
              <div style="font-size: 14px; font-weight: 600; color: #555;"><i class="fa fa-clock-o"></i> {{ message.date_added }}</div>
            </div>
          </div>
          <div class="col-md-3 col-sm-6" style="margin-bottom: 15px;">
            <div style="background: #f8f6f2; border: 1px solid #eeeae0; border-radius: 8px; padding: 16px;">
              <div style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: #888; margin-bottom: 4px;">IP Adresi</div>
              <div style="font-size: 14px; font-weight: 600; color: #555;"><i class="fa fa-globe"></i> {{ message.ip }}</div>
            </div>
          </div>
        </div>

        <div style="margin-top: 10px;">
          <h4 style="font-family: 'Cormorant Garamond', Georgia, serif; font-size: 22px; font-weight: 600; color: #1a1a50; letter-spacing: 0.05em; text-transform: uppercase; margin-bottom: 12px;">
            <i class="fa fa-commenting-o"></i> Mesaj Metni
          </h4>
          <div style="background-color: #fbf9f4; border: 1px solid #eeeae0; border-radius: 10px; padding: 26px; font-size: 15.5px; line-height: 1.8; color: #1a1a50; white-space: pre-wrap; word-break: break-word; min-height: 180px;">{{ message.enquiry|raw }}</div>
        </div>

        <div style="margin-top: 28px; display: flex; gap: 12px; justify-content: flex-end; align-items: center; flex-wrap: wrap;">
          <a href="{{ back }}" class="btn btn-default"><i class="fa fa-arrow-left"></i> Mesaj Listesine Dön</a>
          <a href="mailto:{{ message.email }}?subject=UANNES - İletişim Mesajınız Hakkında" class="btn btn-primary btn-lg"><i class="fa fa-reply"></i> {{ button_reply }}</a>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
