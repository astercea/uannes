{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-uannes-pages" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i> Kaydet</button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i> İptal</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-picture-o"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-uannes-pages" class="form-horizontal">
          <ul class="nav nav-tabs">
            <li class="active"><a href="#tab-home" data-toggle="tab"><i class="fa fa-home"></i> {{ tab_home }}</a></li>
            <li><a href="#tab-hikaye" data-toggle="tab"><i class="fa fa-book"></i> {{ tab_hikaye }}</a></li>
            <li><a href="#tab-kumas" data-toggle="tab"><i class="fa fa-cube"></i> {{ tab_kumas }}</a></li>
            <li><a href="#tab-ozel" data-toggle="tab"><i class="fa fa-magic"></i> {{ tab_ozel_uretim }}</a></li>
          </ul>

          <div class="tab-content" style="padding-top: 20px;">

            <!-- TAB 1: ANA SAYFA -->
            <div class="tab-pane active" id="tab-home">
              <div class="page-header" style="margin: 0 0 20px 0; padding-bottom: 5px;">
                <h4 style="color: #1a1a50; font-weight: 600;"><i class="fa fa-sliders"></i> {{ text_section_slider }}</h4>
                <p class="text-muted"><small>Ana sayfada dönen 5'li model kartı görselleri. Görsel seçilmezse varsayılan model görseli gösterilir.</small></p>
              </div>

              <div class="row">
                <div class="col-sm-2 text-center" style="margin-bottom: 20px;">
                  <label class="control-label" style="display: block; margin-bottom: 8px;">{{ entry_home_slide_1 }}</label>
                  <a href="" id="thumb-slide-1" data-toggle="image" class="img-thumbnail"><img src="{{ thumb_module_uannes_pages_home_slide_1 }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="module_uannes_pages_home_slide_1" value="{{ module_uannes_pages_home_slide_1 }}" id="input-slide-1" />
                </div>
                <div class="col-sm-2 text-center" style="margin-bottom: 20px;">
                  <label class="control-label" style="display: block; margin-bottom: 8px;">{{ entry_home_slide_2 }}</label>
                  <a href="" id="thumb-slide-2" data-toggle="image" class="img-thumbnail"><img src="{{ thumb_module_uannes_pages_home_slide_2 }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="module_uannes_pages_home_slide_2" value="{{ module_uannes_pages_home_slide_2 }}" id="input-slide-2" />
