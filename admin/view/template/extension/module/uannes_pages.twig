                <div class="col-sm-2 text-center" style="margin-bottom: 20px;">
                  <label class="control-label" style="display: block; margin-bottom: 8px;">{{ entry_home_slide_3 }}</label>
                  <a href="" id="thumb-slide-3" data-toggle="image" class="img-thumbnail"><img src="{{ thumb_module_uannes_pages_home_slide_3 }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="module_uannes_pages_home_slide_3" value="{{ module_uannes_pages_home_slide_3 }}" id="input-slide-3" />
                </div>
                <div class="col-sm-2 text-center" style="margin-bottom: 20px;">
                  <label class="control-label" style="display: block; margin-bottom: 8px;">{{ entry_home_slide_4 }}</label>
                  <a href="" id="thumb-slide-4" data-toggle="image" class="img-thumbnail"><img src="{{ thumb_module_uannes_pages_home_slide_4 }}" alt="" title="" data-placeholder="{{ placeholder }}" /></a>
                  <input type="hidden" name="module_uannes_pages_home_slide_4" value="{{ module_uannes_pages_home_slide_4 }}" id="input-slide-4" />
                </div>
                <div class="col-sm-2 text-center" style="margin-bottom: 20px;">
                  <label class="control-label" style="display: block; margin-bottom: 8px;">{{ entry_home_slide_5 }}</label>
