                  <input type="hidden" name="module_uannes_pages_home_discover_hikaye" value="{{ module_uannes_pages_home_discover_hikaye }}" id="input-discover-hikaye" />
                </div>
                <div class="col-sm-4 text-center" style="margin-bottom: 20px;">
